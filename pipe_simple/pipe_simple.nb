      RowBox[{
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", "5"}]}]}]}]}], "'"}], ".", "External"}], " ", 
     "forcing", " ", 
