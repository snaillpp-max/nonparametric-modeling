            RowBox[{
             RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
