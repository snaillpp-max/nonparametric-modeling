   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Simply", " ", "supported", " ", "mode", " ", "functions"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"phi", "[", 
      RowBox[{"n_Integer", ",", "x_"}], "]"}], ":=", 
     RowBox[{"Sin", "[", 
      RowBox[{"n", " ", "Pi", " ", 
       RowBox[{"x", "/", "L"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
