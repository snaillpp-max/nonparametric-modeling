         RowBox[{"rhoF", "*", "AreaFluid", "*", 
          RowBox[{"U0", "^", "2"}]}]}], ")"}], " ", "KaxInt"}]}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "5."}]}]}]}]}], " ", "Geometric", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"nonlinearity", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"qvec", "[", "t_", "]"}], ":=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"q", "[", "#", "]"}], "[", "t", "]"}], "&"}], ",", 
       "Nmodes"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Sgeo", "[", "t_", "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"q", "[", "i", "]"}], "[", "t", "]"}], " ", 
        RowBox[{
         RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}], " ", 
        RowBox[{"KaxInt", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "Nmodes"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
