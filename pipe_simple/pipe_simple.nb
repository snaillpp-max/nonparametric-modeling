   RowBox[{
    RowBox[{"U0", "=", "80"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"U", "[", "t_", "]"}], ":=", "U0"}], ";"}], "      ", 
   RowBox[{"(*", "constant", "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nmodes", "=", "5"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
