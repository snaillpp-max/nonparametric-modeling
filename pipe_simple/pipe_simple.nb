     RowBox[{"Qforc", "[", 
      RowBox[{"i_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"F0", "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"omegaF", " ", "t"}], "]"}], "*", 
      RowBox[{"phi", "[", 
       RowBox[{"i", ",", 
        RowBox[{"L", "/", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "6."}]}]}]}]}], " ", "Build", " ", "ODE", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"system", "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"eqs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mmat", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "+", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cmat", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "+", 
              RowBox[{"2", " ", "rhoF", "*", "AreaFluid", "*", "U0", "*", 
               RowBox[{"Gmat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ")"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}], ",", "t"}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "+", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Klin", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], " ", 
            RowBox[{
             RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"EYoung", "*", 
              RowBox[{"AreaPipe", "/", 
               RowBox[{"(", 
                RowBox[{"2", " ", "L"}], ")"}]}]}], ")"}]}], "*", 
           RowBox[{"Sgeo", "[", "t", "]"}], "*", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Jmat", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], " ", 
              RowBox[{
               RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}]}], ")"}]}], "==", 
        RowBox[{"Qforc", "[", 
         RowBox[{"i", ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "Nmodes"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "7."}]}]}]}]}], " ", "Initial", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"conditions", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ics", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"q", "[", "n", "]"}], "[", "0", "]"}], "==", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"n", "==", "1"}], ",", 
            RowBox[{"1.", "*", 
             RowBox[{"10", "^", 
              RowBox[{"-", "4"}]}]}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "Nmodes"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"q", "[", "n", "]"}], "'"}], "[", "0", "]"}], "==", "0"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "Nmodes"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmax", "=", 
     RowBox[{"100", "*", "2", "*", 
      RowBox[{"Pi", "/", "omegaF"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "matrices", " ", "to", " ", "machine", " ", "numbers"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Mmat", "=", 
     RowBox[{"N", "[", "Mmat", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Kbend", "=", 
     RowBox[{"N", "[", "Kbend", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"KaxInt", "=", 
     RowBox[{"N", "[", "KaxInt", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Gmat", "=", 
     RowBox[{"N", "[", "Gmat", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Jmat", "=", 
     RowBox[{"N", "[", "Jmat", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Cmat", "=", 
     RowBox[{"N", "[", "Cmat", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Klin", "=", 
     RowBox[{"N", "[", "Klin", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"eqs", ",", "ics"}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"q", "[", "n", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "Nmodes"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<EquationSimplification\>\"", "->", "\"\<Residual\>\""}], 
          "}"}]}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", "8."}]}]}]}]}], " ", "Mid"}], "-", 
     RowBox[{"span", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"displacement", "--"}], "--"}], "--"}], "--"}], "--"}]}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"wMid", "[", "t_", "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "[", "n", "]"}], "[", "t", "]"}], "/.", " ", "sol"}], 
         ")"}], "*", 
        RowBox[{"phi", "[", 
         RowBox[{"n", ",", 
          RowBox[{"L", "/", "2"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "Nmodes"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"midPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"wMid", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t (s)\>\"", ",", "\"\<w(L/2,t) (m)\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{
        "\"\<Mid-span displacement (Cosine forced vibration, Nmodes = \>\"", "<>", 
         RowBox[{"ToString", "[", "Nmodes", "]"}], "<>", "\"\<)\>\""}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "midPlot", "\n", "\n"}]}]], "Input",
