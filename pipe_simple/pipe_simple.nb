             RowBox[{"{", 
              RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}]}], ")"}]}], "==", 
        RowBox[{"Qforc", "[", 
         RowBox[{"i", ",", "t"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "Nmodes"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
