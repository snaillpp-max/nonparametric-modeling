Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Pipe", " ", "true", " ", "model", " ", "versus", " ", 
    RowBox[{"NN", ":", 
     RowBox[{
      RowBox[{"generalized", " ", "time"}], "-", 
      RowBox[{"history", " ", "comparison"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"SetDirectory", "@", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"$InputFileName", "===", "\"\<\>\""}], ",", 
       RowBox[{"NotebookDirectory", "[", "]"}], ",", 
       RowBox[{"DirectoryName", "[", "$InputFileName", "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Current directory: \>\"", ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "File", " ", "names"}], "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"netFile", "=", "\"\<trainedNet_pipe_flow_cos_final.wlnet\>\""}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"normFile", "=", "\"\<normParams_pipe_flow_cos_final.mx\>\""}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "netFile", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<ERROR: network file not found: \>\"", ",", "netFile"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "normFile", "]"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<ERROR: normalization file not found: \>\"", ",", "normFile"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Physical", " ", "parameters", " ", "from", " ", "pipe_simple", 
     RowBox[{
      RowBox[{"(", "4", ")"}], ".", "nb"}]}], "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", "1.0"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Douter", "=", "0.01"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Dinner", "=", "0.009"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"EYoung", "=", 
     RowBox[{"2.06", "*", 
      RowBox[{"10", "^", "11"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rhoS", "=", "7850."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoF", "=", "1000."}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"AreaPipe", "=", 
     RowBox[{
      RowBox[{"Pi", "/", "4"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Douter", "^", "2"}], "-", 
        RowBox[{"Dinner", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AreaFluid", "=", 
     RowBox[{
      RowBox[{"Pi", "/", "4"}], " ", 
      RowBox[{"Dinner", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Isec", "=", 
     RowBox[{
      RowBox[{"Pi", "/", "64"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Douter", "^", "4"}], "-", 
        RowBox[{"Dinner", "^", "4"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"mLine", "=", 
     RowBox[{
      RowBox[{"rhoS", " ", "AreaPipe"}], "+", 
      RowBox[{"rhoF", " ", "AreaFluid"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"T0", "=", "0.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cDamp", "=", "0.3"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Nmodes", "=", "3"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Simply", " ", "supported", " ", "mode", " ", "functions"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"phi", "[", 
      RowBox[{"n_Integer", ",", "x_"}], "]"}], ":=", 
     RowBox[{"Sin", "[", 
      RowBox[{"n", " ", "Pi", " ", 
       RowBox[{"x", "/", "L"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Galerkin", " ", "matrices"}], "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nBuilding physical-model matrices...\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Mmat", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"mLine", " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"phi", "[", 
            RowBox[{"i", ",", "x"}], "]"}], " ", 
           RowBox[{"phi", "[", 
            RowBox[{"j", ",", "x"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nmodes"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "Nmodes"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Kbend", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"EYoung", " ", "Isec", " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"phi", "[", 
              RowBox[{"i", ",", "x"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "2"}], "}"}]}], "]"}], " ", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"phi", "[", 
              RowBox[{"j", ",", "x"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nmodes"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "Nmodes"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"KaxInt", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"phi", "[", 
             RowBox[{"i", ",", "x"}], "]"}], ",", "x"}], "]"}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"phi", "[", 
             RowBox[{"j", ",", "x"}], "]"}], ",", "x"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nmodes"}], "}"}], ",", 
       RowBox[{"{", 
