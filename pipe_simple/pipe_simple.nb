        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Cosine", " ", "excitation"}], ")"}], "--"}], "--"}], 
        "--"}], "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"F0", "=", "0.0"}], ";"}], "           ", 
   RowBox[{"(*", 
