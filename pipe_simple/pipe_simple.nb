         RowBox[{"Parameters", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"L", "=", "1.0"}], ";"}], "                ", 
   RowBox[{"(*", 
    RowBox[{"pipe", " ", 
     RowBox[{"length", "[", "m", "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Douter", "=", "0.01"}], ";"}], "          ", 
   RowBox[{"(*", 
    RowBox[{"outer", " ", 
     RowBox[{"diameter", "[", "m", "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Dinner", "=", "0.009"}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{"inner", " ", 
     RowBox[{"diameter", "[", "m", "]"}]}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EYoung", "=", 
     RowBox[{"2.06", "*", 
      RowBox[{"10", "^", "11"}]}]}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Young", "'"}], "s", " ", 
     RowBox[{"modulus", "[", "Pa", "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhoS", "=", "7850."}], ";"}], "           ", 
   RowBox[{"(*", 
    RowBox[{"density", " ", "of", " ", 
     RowBox[{"steel", "[", 
      RowBox[{"kg", "/", 
       RowBox[{"m", "^", "3"}]}], "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhoF", "=", "1000."}], ";"}], "           ", 
   RowBox[{"(*", 
    RowBox[{"density", " ", "of", " ", 
     RowBox[{"water", "[", 
      RowBox[{"kg", "/", 
       RowBox[{"m", "^", "3"}]}], "]"}]}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AreaPipe", "=", 
     RowBox[{
      RowBox[{"Pi", "/", "4"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Douter", "^", "2"}], "-", 
        RowBox[{"Dinner", "^", "2"}]}], ")"}]}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"pipe", " ", "wall", " ", "area"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"AreaFluid", "=", 
     RowBox[{
      RowBox[{"Pi", "/", "4"}], " ", 
      RowBox[{"Dinner", "^", "2"}]}]}], ";"}], "               ", 
   RowBox[{"(*", 
    RowBox[{"fluid", " ", "area"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Isec", "=", 
     RowBox[{
      RowBox[{"Pi", "/", "64"}], " ", 
