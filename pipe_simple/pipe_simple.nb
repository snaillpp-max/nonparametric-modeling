      RowBox[{"10", "^", "11"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"rhoS", "=", "7850."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoF", "=", "1000."}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"AreaPipe", "=", 
     RowBox[{
      RowBox[{"Pi", "/", "4"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Douter", "^", "2"}], "-", 
        RowBox[{"Dinner", "^", "2"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AreaFluid", "=", 
