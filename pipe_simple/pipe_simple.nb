             RowBox[{"phi", "[", 
              RowBox[{"j", ",", "x"}], "]"}], ",", "x"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Nmodes"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "//", "Simplify"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Gmat", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"phi", "[", 
            RowBox[{"i", ",", "x"}], "]"}], "*", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"phi", "[", 
              RowBox[{"j", ",", "x"}], "]"}], ",", "x"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Nmodes"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "//", "Simplify"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Jmat", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"phi", "[", 
            RowBox[{"i", ",", "x"}], "]"}], "*", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"phi", "[", 
              RowBox[{"j", ",", "x"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Nmodes"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "//", "Simplify"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Cmat", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"cDamp", "/", "mLine"}], ")"}], " ", "Mmat"}]}], ";"}], "   ", 
   RowBox[{"(*", 
    RowBox[{"viscous", " ", "damping", " ", "matrix"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "4."}]}]}]}]}], " ", "Linear", " ", "stiffness", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"constant", " ", "because", " ", "U0"}], "=", "const"}], 
           ")"}], "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Klin", "=", 
