        RowBox[{"Douter", "^", "4"}], "-", 
        RowBox[{"Dinner", "^", "4"}]}], ")"}]}]}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"2", "nd", " ", "moment", " ", "of", " ", "area"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"mLine", "=", 
     RowBox[{
      RowBox[{"rhoS", "*", "AreaPipe"}], "+", 
