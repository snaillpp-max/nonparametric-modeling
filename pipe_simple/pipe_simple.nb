 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CreateSampledData", "[", 
     RowBox[{"yTrue_", ",", "yPred_", ",", "errors_", ",", "maxRows_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sampleIndices", ",", "actualTrue", ",", "actualPred", ",", 
        "actualErrors"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "yTrue", "]"}], ">", "maxRows"}], ",", 
         RowBox[{
          RowBox[{"sampleIndices", "=", 
           RowBox[{"RandomSample", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "yTrue", "]"}], "]"}], ",", "maxRows"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"actualTrue", "=", 
           RowBox[{"yTrue", "[", 
            RowBox[{"[", "sampleIndices", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"actualPred", "=", 
           RowBox[{"yPred", "[", 
            RowBox[{"[", "sampleIndices", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"actualErrors", "=", 
           RowBox[{"errors", "[", 
            RowBox[{"[", "sampleIndices", "]"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"actualTrue", "=", "yTrue"}], ";", "\[IndentingNewLine]", 
          RowBox[{"actualPred", "=", "yPred"}], ";", "\[IndentingNewLine]", 
          RowBox[{"actualErrors", "=", "errors"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\:771f\:5b9e q1ddot\>\"", ",", "\"\<\:9884\:6d4b q1ddot\>\"", 
            ",", "\"\<\:8bef\:5dee\>\"", ",", 
            "\"\<\:7edd\:5bf9\:8bef\:5dee\>\"", ",", 
            "\"\<\:76f8\:5bf9\:8bef\:5dee(%)\>\""}], "}"}], "}"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"actualTrue", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"actualPred", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"actualErrors", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"actualErrors", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"actualTrue", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], ">", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "10"}]}]}], ",", 
               RowBox[{"100", "*", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"actualErrors", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}], "/", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"actualTrue", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ",", "0"}], 
              "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "actualTrue", "]"}]}], "}"}]}], "]"}]}], 
        "]"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
