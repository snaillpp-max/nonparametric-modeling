    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nBuilding physical-model matrices...\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Mmat", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"mLine", " ", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"phi", "[", 
            RowBox[{"i", ",", "x"}], "]"}], " ", 
           RowBox[{"phi", "[", 
            RowBox[{"j", ",", "x"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nmodes"}], "}"}], ",", 
       RowBox[{"{", 
