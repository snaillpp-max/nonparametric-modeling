        RowBox[{"--", 
         RowBox[{"--", "6."}]}]}]}]}], " ", "Build", " ", "ODE", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"system", "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eqs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mmat", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "2"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "+", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cmat", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "+", 
              RowBox[{"2", " ", "rhoF", "*", "AreaFluid", "*", "U0", "*", 
               RowBox[{"Gmat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ")"}], " ", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"q", "[", "j", "]"}], "[", "t", "]"}], ",", "t"}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "Nmodes"}], "}"}]}], "]"}], "+", 
