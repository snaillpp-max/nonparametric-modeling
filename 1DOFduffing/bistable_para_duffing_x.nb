   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "nnInternalAccel", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\:8f93\:5165", ":", "x"}], ",", "v", ",", "\[Kappa]", ",", 
     "\[CapitalOmega]", ",", 
     RowBox[{
      RowBox[{"t", "->", 
       RowBox[{"\:8f93\:51fa", ":", "ga"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "c"}], "*", "v"}], "-", 
       RowBox[{"\[Alpha]", "*", "x"}], "-", 
       RowBox[{"\[Beta]", "*", "x\.b3"}], "+", 
       RowBox[{"\[Kappa]", "*", "x", "*", "cos", 
        RowBox[{"(", 
         RowBox[{"\[CapitalOmega]", "*", "t"}], ")"}]}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"nnInternalAccel", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"v_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Kappa]_", "?", "NumericQ"}], ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}], ",", 
       RowBox[{"t_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"kc", ",", "ks", ",", "z", ",", "out"}], "}"}], ",", 
       RowBox[{
        RowBox[{"kc", "=", 
         RowBox[{"\[Kappa]", "*", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[CapitalOmega]", "*", "t"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ks", "=", 
         RowBox[{"\[Kappa]", "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[CapitalOmega]", "*", "t"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"z", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "v", ",", "kc", ",", "ks"}], "}"}], "-", 
            "inputMean"}], ")"}], "/", "inputStd"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"out", "=", 
         RowBox[{"trainedNet", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"scalar", "[", "out", "]"}], "*", 
          RowBox[{"scalar", "[", "targetStd", "]"}]}], "+", 
         RowBox[{"scalar", "[", "targetMean", "]"}]}]}]}], "]"}]}], ";"}], 
