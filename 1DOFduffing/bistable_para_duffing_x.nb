Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"FRFSweep", ",", "PlotFRF"}], "]"}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "\:4fee\:6539\:540e\:7684FRF\:626b\:63cf", "\:ff1a", 
    "\:9002\:914d\:53c2\:6570\:6fc0\:52b1"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FRFSweep", "[", 
     RowBox[{
      RowBox[{"\[Alpha]_", ":", 
       RowBox[{"-", "1."}]}], ",", 
      RowBox[{"\[Beta]_", ":", "1."}], ",", 
      RowBox[{"c_", ":", "0.3"}], ",", 
      RowBox[{"F_", ":", "0.16"}], ",", 
      RowBox[{"\[CapitalOmega]1min_", ":", "0.5"}], ",", 
      RowBox[{"\[CapitalOmega]1max_", ":", "1.5"}], ",", 
      RowBox[{"d\[CapitalOmega]1_", ":", "0.01"}], ",", 
      RowBox[{"\[Kappa]_", ":", "0.0"}], ",", 
      RowBox[{"\[CapitalOmega]2_", ":", "1"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "\:65b0\:589e", "\:ff1a", "\:53c2\:6570\:6fc0\:52b1\:53c2\:6570"}], 
       "*)"}], 
      RowBox[{"cyclesSettle_", ":", "60"}], ",", 
      RowBox[{"cyclesMeasure_", ":", "20"}], ",", 
      RowBox[{"dt_", ":", "0.001"}], ",", 
      RowBox[{"ic_", ":", "Automatic"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "stables", ",", "ic0", ",", "doOne", ",", "forwardGrid", ",", 
        "backwardGrid", ",", "state", ",", "res", ",", "forward", ",", 
        "backward"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"\:53c2\:8003\:5e73\:8861\:70b9", 
        RowBox[{"\:ff08", "\:65e0\:6fc0\:52b1\:65f6", "\:ff09"}]}], "*)"}], 
      RowBox[{
       RowBox[{"stables", "=", 
        RowBox[{"FindStableEq", "[", 
         RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "stables", "]"}], "<", "2"}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<\:672a\:627e\:5230\:4e24\:4e2a\:7a33\:5b9a\:5e73\:8861\:ff08\
\:53c2\:8003 F=0\:ff09\:3002\:8bf7\:68c0\:67e5 \[Alpha]<0, \
\[Beta]>0\:3002\>\"", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ic0", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ic", "===", "Automatic"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"stables", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "0.0"}], "}"}], ",", "ic"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "(*", "\:5355\:4e2a\:9891\:7387\:70b9\:7684\:8ba1\:7b97", "*)"}], 
       RowBox[{
        RowBox[{"doOne", "[", 
         RowBox[{"\[CapitalOmega]1_", ",", 
          RowBox[{"{", 
           RowBox[{"x0_", ",", "v0_"}], "}"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"T", "=", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "\[CapitalOmega]1"}]}]}], ",", "tS", ",", 
            "tM", ",", "xFun", ",", "vFun", ",", "ts", ",", "xs", ",", "xmax",
             ",", "xmin", ",", "amp", ",", "rms", ",", "last"}], "}"}], ",", 
          RowBox[{
           RowBox[{"tS", "=", 
            RowBox[{"cyclesSettle", "*", "T"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"tM", "=", 
            RowBox[{"cyclesMeasure", "*", "T"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Clear", "[", 
            RowBox[{"x", ",", "v", ",", "t"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "\:4fee\:6539\:7684\:8fd0\:52a8\:65b9\:7a0b", "\:ff1a", 
             "\:5305\:542b\:53c2\:6570\:6fc0\:52b1"}], "*)"}], 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"xFun", ",", "vFun"}], "}"}], "=", 
            RowBox[{"NDSolveValue", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
                 RowBox[{"v", "[", "t", "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "c"}], " ", 
                   RowBox[{"v", "[", "t", "]"}]}], "-", 
                  RowBox[{"\[Alpha]", " ", 
                   RowBox[{"x", "[", "t", "]"}]}], "-", 
                  RowBox[{"\[Beta]", " ", 
                   RowBox[{
                    RowBox[{"x", "[", "t", "]"}], "^", "3"}]}], "+", 
                  RowBox[{"F", " ", 
                   RowBox[{"Cos", "[", 
                    RowBox[{"\[CapitalOmega]1", " ", "t"}], "]"}]}], "+", 
                  RowBox[{"\[Kappa]", " ", 
                   RowBox[{"x", "[", "t", "]"}], " ", 
                   RowBox[{"Cos", "[", 
                    RowBox[{"\[CapitalOmega]2", " ", "t"}], "]"}]}]}]}], ",", 
                RowBox[{
                 RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
                RowBox[{
                 RowBox[{"v", "[", "0", "]"}], "==", "v0"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "v"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "0", ",", 
                RowBox[{"tS", "+", "tM"}]}], "}"}], ",", 
              RowBox[{"Method", "->", "\"\<ExplicitRungeKutta\>\""}], ",", 
              RowBox[{"MaxStepFraction", "->", "0.1"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"ts", "=", 
            RowBox[{"Range", "[", 
             RowBox[{"tS", ",", 
              RowBox[{"tS", "+", "tM"}], ",", "dt"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"xs", "=", 
            RowBox[{"xFun", "/@", "ts"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"xmax", "=", 
            RowBox[{"Max", "[", "xs", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"xmin", "=", 
            RowBox[{"Min", "[", "xs", "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"amp", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"xmax", "-", "xmin"}], ")"}], "/", "2."}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"rms", "=", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"Mean", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"xs", "-", 
                 RowBox[{"Mean", "[", "xs", "]"}]}], ")"}], "^", "2"}], "]"}],
              "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"last", "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"xFun", "[", 
               RowBox[{"tS", "+", "tM"}], "]"}], ",", 
              RowBox[{"vFun", "[", 
               RowBox[{"tS", "+", "tM"}], "]"}]}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Omega1\>\"", "->", "\[CapitalOmega]1"}], ",", 
             RowBox[{"\"\<Amp\>\"", "->", "amp"}], ",", 
             RowBox[{"\"\<xmax\>\"", "->", "xmax"}], ",", 
             RowBox[{"\"\<xmin\>\"", "->", "xmin"}], ",", 
             RowBox[{"\"\<RMS\>\"", "->", "rms"}], ",", 
             RowBox[{"\"\<xend\>\"", "->", 
              RowBox[{"last", "[", 
