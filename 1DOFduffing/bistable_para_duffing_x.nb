Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ComputeLyapunovExponentParam", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "\:8ba1\:7b97\:6700\:5927\:674e\:96c5\:666e\:8bfa\:592b\:6307\:6570", "-", 
    "\:53c2\:6570\:6fc0\:52b1\:7cfb\:7edf"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ComputeLyapunovExponentParam", "[", 
     RowBox[{
      RowBox[{"freqParam_", "?", "NumericQ"}], ",", 
      RowBox[{"kappa_", "?", "NumericQ"}], ",", 
      RowBox[{"freqForce_", "?", "NumericQ"}], ",", 
      RowBox[{"force_", "?", "NumericQ"}], ",", 
      RowBox[{"x0_", "?", "NumericQ"}], ",", 
      RowBox[{"nTransient_", ":", "100"}], ",", 
      RowBox[{"nCompute_", ":", "100"}], ",", 
      RowBox[{"systemType_", ":", "\"\<NN\>\""}], ",", 
      RowBox[{"v0_", ":", "0."}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "T", ",", "tTrans", ",", "tCompute", ",", "x0Start", ",", "v0Start", 
        ",", "sol", ",", "xFunc", ",", "vFunc", ",", 
        RowBox[{"disturb", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], ",", "solRef", ",", "solPert", ",", "xRef", 
        ",", "vRef", ",", "xPert", ",", "vPert", ",", "dt", ",", "tList", ",",
         "distanceList", ",", "lyapunovTable", ",", "lambda"}], "}"}], ",", 
      RowBox[{
      "(*", "\:57fa\:4e8e\:5916\:6fc0\:52b1\:548c\:53c2\:6570\:6fc0\:52b1\
\:4e2d\:7684\:6700\:9ad8\:9891\:7387", "*)"}], 
      RowBox[{
       RowBox[{"T", "=", 
        RowBox[{"1", "/", 
         RowBox[{"Max", "[", 
          RowBox[{"freqForce", ",", "freqParam"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tTrans", "=", 
        RowBox[{"nTransient", "*", "T"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tCompute", "=", 
        RowBox[{"nCompute", "*", "T"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\:6b65\:9aa41", ":", "\:79ef\:5206\:5230\:7a33\:6001"}], 
        "*)"}], 
       RowBox[{"sol", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"systemType", "==", "\"\<NN\>\""}], ",", 
