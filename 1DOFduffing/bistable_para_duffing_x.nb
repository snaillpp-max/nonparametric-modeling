      RowBox[{"normParams", "=", 
       RowBox[{"Import", "[", "\"\<normParams_final.mx\>\"", "]"}]}]}], "]"}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inputMean", "=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"normParams", ",", "\"\<inputMean\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"inputStd", "=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"normParams", ",", "\"\<inputStd\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetMean", "=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"normParams", ",", "\"\<targetMean\>\"", ",", 
       RowBox[{"Lookup", "[", 
        RowBox[{"normParams", ",", "\"\<targetMeanGa\>\"", ",", "0."}], 
        "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetStd", "=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"normParams", ",", "\"\<targetStd\>\"", ",", 
       RowBox[{"Lookup", "[", 
        RowBox[{"normParams", ",", "\"\<targetStdGa\>\"", ",", "1."}], 
        "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"scalar", "[", "x_", "]"}], ":=", 
     RowBox[{"First", "@", 
      RowBox[{"Flatten", "@", 
       RowBox[{"{", "x", "}"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\:2705 \:6a21\:578b\:52a0\:8f7d\:5b8c\:6210\>\"", 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{" ", 
