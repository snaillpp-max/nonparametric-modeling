                ",", "v0"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"result", "===", "$Failed"}], ",", 
               RowBox[{
                RowBox[{"lambda", "=", "\"\<Failed\>\""}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"chaosType", "=", "\"\<Failed\>\""}]}], ",", 
               RowBox[{
                RowBox[{"lambda", "=", 
                 RowBox[{"result", "[", 
                  RowBox[{"[", "5", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                "(*", "\:5224\:65ad\:6df7\:6c8c\:6216\:5468\:671f", "*)"}], 
                RowBox[{"chaosType", "=", 
