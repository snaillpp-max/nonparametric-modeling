    "\:56fa\:5b9a\:5916\:6fc0\:52b1\:7cfb\:7edf"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ComputeLyapunovExponentForceFixed", "[", 
     RowBox[{
      RowBox[{"freqForce_", "?", "NumericQ"}], ",", 
      RowBox[{"force_", "?", "NumericQ"}], ",", 
      RowBox[{"freqParam_", "?", "NumericQ"}], ",", 
      RowBox[{"kappa_", "?", "NumericQ"}], ",", 
      RowBox[{"x0_", "?", "NumericQ"}], ",", 
      RowBox[{"nTransient_", ":", "100"}], ",", 
      RowBox[{"nCompute_", ":", "100"}], ",", 
      RowBox[{"systemType_", ":", "\"\<NN\>\""}], ",", 
      RowBox[{"v0_", ":", "0."}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "T", ",", "tTrans", ",", "tCompute", ",", "x0Start", ",", "v0Start", 
        ",", "sol", ",", "xFunc", ",", "vFunc", ",", 
        RowBox[{"disturb", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}]}], ",", "solRef", ",", "solPert", ",", "xRef", 
        ",", "vRef", ",", "xPert", ",", "vPert", ",", "dt", ",", "tList", ",",
         "distanceList", ",", "lyapunovTable", ",", "lambda"}], "}"}], ",", 
      RowBox[{
      "(*", "\:57fa\:4e8e\:5916\:6fc0\:52b1\:548c\:53c2\:6570\:6fc0\:52b1\
\:4e2d\:7684\:6700\:9ad8\:9891\:7387", "*)"}], 
      RowBox[{
       RowBox[{"T", "=", 
        RowBox[{"1", "/", 
         RowBox[{"Max", "[", 
          RowBox[{"freqForce", ",", "freqParam"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tTrans", "=", 
        RowBox[{"nTransient", "*", "T"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tCompute", "=", 
        RowBox[{"nCompute", "*", "T"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\:6b65\:9aa41", ":", "\:79ef\:5206\:5230\:7a33\:6001"}], 
        "*)"}], 
       RowBox[{"sol", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"systemType", "==", "\"\<NN\>\""}], ",", 
          RowBox[{"SolveNN", "[", 
           RowBox[{
           "freqParam", ",", "kappa", ",", "x0", ",", "tTrans", ",", "v0", 
            ",", "freqForce", ",", "force"}], "]"}], ",", 
          RowBox[{"SolveTruth", "[", 
           RowBox[{
           "freqParam", ",", "kappa", ",", "x0", ",", "tTrans", ",", "v0", 
            ",", "freqForce", ",", "force"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xFunc", "=", 
        RowBox[{"x", "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vFunc", "=", 
        RowBox[{
         RowBox[{"x", "'"}], "/.", " ", "sol"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x0Start", "=", 
        RowBox[{"xFunc", "[", "tTrans", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"v0Start", "=", 
        RowBox[{"vFunc", "[", "tTrans", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\:6b65\:9aa42", ":", "\:4ece\:7a33\:6001\:5f00\:59cb"}], 
         "\:ff0c", 
         "\:79ef\:5206\:53c2\:8003\:8f68\:9053\:548c\:6270\:52a8\:8f68\:9053"}\
], "*)"}], 
       RowBox[{"solRef", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"systemType", "==", "\"\<NN\>\""}], ",", 
          RowBox[{"SolveNN", "[", 
           RowBox[{
           "freqParam", ",", "kappa", ",", "x0Start", ",", "tCompute", ",", 
            "v0Start", ",", "freqForce", ",", "force"}], "]"}], ",", 
          RowBox[{"SolveTruth", "[", 
           RowBox[{
           "freqParam", ",", "kappa", ",", "x0Start", ",", "tCompute", ",", 
            "v0Start", ",", "freqForce", ",", "force"}], "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"solRef", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"solPert", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"systemType", "==", "\"\<NN\>\""}], ",", 
          RowBox[{"SolveNN", "[", 
           RowBox[{"freqParam", ",", "kappa", ",", 
            RowBox[{"x0Start", "+", "disturb"}], ",", "tCompute", ",", 
            "v0Start", ",", "freqForce", ",", "force"}], "]"}], ",", 
          RowBox[{"SolveTruth", "[", 
           RowBox[{"freqParam", ",", "kappa", ",", 
            RowBox[{"x0Start", "+", "disturb"}], ",", "tCompute", ",", 
            "v0Start", ",", "freqForce", ",", "force"}], "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"solPert", "===", "$Failed"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xRef", "=", 
        RowBox[{"x", "/.", " ", "solRef"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vRef", "=", 
        RowBox[{
         RowBox[{"x", "'"}], "/.", " ", "solRef"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xPert", "=", 
        RowBox[{"x", "/.", " ", "solPert"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vPert", "=", 
        RowBox[{
         RowBox[{"x", "'"}], "/.", " ", "solPert"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "\:6b65\:9aa43", ":", 
         "\:5728\:65f6\:95f4\:7f51\:683c\:4e0a\:8ba1\:7b97\:8ddd\:79bb"}], 
        "*)"}], 
       RowBox[{"dt", "=", 
        RowBox[{"T", "/", "100"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tList", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"dt", ",", "tCompute", ",", "dt"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"distanceList", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"xPert", "[", "t", "]"}], "-", 
               RowBox[{"xRef", "[", "t", "]"}]}], ")"}], "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"vPert", "[", "t", "]"}], "-", 
               RowBox[{"vRef", "[", "t", "]"}]}], ")"}], "^", "2"}]}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "tList"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\:68c0\:67e5\:6570\:503c\:7a33\:5b9a\:6027", "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", "distanceList", "]"}], "<=", "0"}], "||", 
          RowBox[{
           RowBox[{"Max", "[", "distanceList", "]"}], ">", "100"}]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "\:6b65\:9aa44", ":", 
         "\:8ba1\:7b97\:674e\:96c5\:666e\:8bfa\:592b\:6307\:6570"}], "*)"}], 
       RowBox[{"lyapunovTable", "=", 
        RowBox[{"Log", "[", 
         RowBox[{"distanceList", "/", "disturb"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"lambda", "=", 
        RowBox[{
         RowBox[{"Total", "[", "lyapunovTable", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Length", "[", "tList", "]"}], "*", "dt"}], ")"}]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", "\:8fd4\:56de\:7ed3\:679c", "*)"}], 
       RowBox[{"{", 
        RowBox[{
        "freqForce", ",", "force", ",", "freqParam", ",", "kappa", ",", 
         "lambda"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
