          RowBox[{"truth", "=", 
           RowBox[{"resultsTruth", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"diffLambda", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"nn", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "===", "\"\<Failed\>\""}], "||", 
              RowBox[{
               RowBox[{"truth", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "===", "\"\<Failed\>\""}]}], 
             ",", "\"\<N/A\>\"", ",", 
             RowBox[{
              RowBox[{"nn", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "-", 
