       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"current", "++"}], ";", "\[IndentingNewLine]", 
             RowBox[{"result", "=", 
