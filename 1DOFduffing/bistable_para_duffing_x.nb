     RowBox[{"resultsNN_", ",", "resultsTruth_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "comparison", ",", "nn", ",", "truth", ",", "diffLambda", ",", 
        "diffType"}], "}"}], ",", 
      RowBox[{
       RowBox[{"comparison", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"nn", "=", 
           RowBox[{"resultsNN", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"truth", "=", 
           RowBox[{"resultsTruth", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"diffLambda", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"nn", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "===", "\"\<Failed\>\""}], "||", 
              RowBox[{
               RowBox[{"truth", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "===", "\"\<Failed\>\""}]}], 
             ",", "\"\<N/A\>\"", ",", 
