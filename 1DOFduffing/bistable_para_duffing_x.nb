 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ExportToExcelByTypeForceFixed", "[", 
     RowBox[{"results_", ",", "filename_", ",", 
      RowBox[{"systemType_", ":", "\"\<NN\>\""}], ",", "freqForce_", ",", 
