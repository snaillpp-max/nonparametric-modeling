Cell[BoxData[{
 RowBox[{"SetDirectory", "@", 
  RowBox[{"NotebookDirectory", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"FindStableEq", ",", "IntegrateAndPlotForced"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "\:4ec5\:7528\:4e8e\:7ed9\:521d\:503c\:5b9a\:4f4d\:5de6\:53f3\:4e95\:7684",\
 "\"\<\:53c2\:8003\:9759\:5e73\:8861\>\"", 
    RowBox[{"\:ff08", 
     RowBox[{
      RowBox[{"\:53ea\:770b", " ", "F0"}], "\:ff0c", 
      RowBox[{"\:4e0d\:542b", " ", "Cos", " ", "\:9879"}]}], "\:ff09"}]}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FindStableEq", "[", 
     RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "F0_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "xs", "}"}], ",", 
      RowBox[{
       RowBox[{"xs", "=", 
        RowBox[{"x", "/.", " ", 
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Beta]", " ", 
              RowBox[{"x", "^", "3"}]}], "+", 
             RowBox[{"\[Alpha]", " ", "x"}], "-", "F0"}], "==", "0"}], ",", 
           "x", ",", "Reals"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Sort", "@", 
        RowBox[{"Select", "[", 
         RowBox[{"xs", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Alpha]", "+", 
              RowBox[{"3", " ", "\[Beta]", " ", 
               RowBox[{"#", "^", "2"}]}]}], ")"}], ">", "0"}], "&"}]}], 
         "]"}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\:4fee\:6539\:540e\:7684\:51fd\:6570", "\:ff1a", 
    RowBox[{
     RowBox[{
      RowBox[{"\:65b9\:7a0b", " ", "\:1e8d"}], "+", "c\:1e8b", "+", 
      "\[Alpha]x", "+", "\[Beta]x\.b3"}], "=", 
     RowBox[{"\[Kappa]", " ", "cos", 
      RowBox[{"(", "\[CapitalOmega]t", ")"}], " ", "x\.b2"}]}]}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IntegrateAndPlotForced", "[", 
     RowBox[{
      RowBox[{"\[Alpha]_", ":", 
       RowBox[{"-", "1."}]}], ",", 
      RowBox[{"\[Beta]_", ":", "1."}], ",", 
      RowBox[{"c_", ":", "0.3"}], ",", 
      RowBox[{"\[Kappa]_", ":", "0.2"}], ",", 
      RowBox[{"\[CapitalOmega]_", ":", "1"}], ",", 
      RowBox[{"tmax_", ":", "400."}], ",", 
      RowBox[{"dt_", ":", "0.001"}], ",", 
      RowBox[{"ic_", ":", "Automatic"}], ",", 
      RowBox[{"tSettle_", ":", "20."}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "stables", ",", "x0", ",", "v0", ",", "xFun", ",", "vFun", ",", "t", 
        ",", "T", ",", "tgrid", ",", "xPlot", ",", "vPlot", ",", "phasePlot", 
        ",", "eqPts", ",", "eqOverlay", ",", "poincT0", ",", "nP", ",", 
        "poincPts", ",", "poincPlot"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"\:53c2\:8003\:5e73\:8861\:70b9", 
        RowBox[{"\:ff08", 
         RowBox[{"\:65e0\:6fc0\:52b1\:65f6", "\:ff0c", 
          RowBox[{"\[Kappa]", "=", "0"}]}], "\:ff09"}]}], "*)"}], 
      RowBox[{
       RowBox[{"stables", "=", 
        RowBox[{"FindStableEq", "[", 
         RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "0"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "stables", "]"}], "<", "2"}], ",", 
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<\:672a\:627e\:5230\:4e24\:4e2a\:7a33\:5b9a\:5e73\:8861\:ff08\
\:53c2\:8003 F0=0\:ff09\:3002\:8bf7\:68c0\:67e5 \[Alpha]<0, \[Beta]>0\:3002\>\
\"", "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x0", ",", "v0"}], "}"}], "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ic", "===", "Automatic"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"stables", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "0.0"}], "}"}], ",", "ic"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"T", "=", 
        RowBox[{"2", " ", 
         RowBox[{"Pi", "/", "\[CapitalOmega]"}]}]}], ";", 
       RowBox[{"(*", "\:6fc0\:52b1\:5468\:671f", "*)"}], 
       RowBox[{"Clear", "[", 
        RowBox[{"x", ",", "v", ",", "t"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\:8fd0\:52a8\:65b9\:7a0b", "\:ff1a", 
         RowBox[{
          RowBox[{
          "\:1e8d", "+", "c\:1e8b", "+", "\[Alpha]x", "+", "\[Beta]x\.b3"}], 
          "=", 
          RowBox[{"\[Kappa]", " ", "cos", 
           RowBox[{"(", "\[CapitalOmega]t", ")"}], " ", "x\.b2"}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xFun", ",", "vFun"}], "}"}], "=", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
             RowBox[{"v", "[", "t", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"v", "'"}], "[", "t", "]"}], "==", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "c"}], " ", 
               RowBox[{"v", "[", "t", "]"}]}], "-", 
              RowBox[{"\[Alpha]", " ", 
               RowBox[{"x", "[", "t", "]"}]}], "-", 
              RowBox[{"\[Beta]", " ", 
               RowBox[{
                RowBox[{"x", "[", "t", "]"}], "^", "3"}]}], "+", 
              RowBox[{"\[Kappa]", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[CapitalOmega]", " ", "t"}], "]"}], " ", 
               RowBox[{
                RowBox[{"x", "[", "t", "]"}], "^", "2"}]}]}]}], ",", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
            RowBox[{
             RowBox[{"v", "[", "0", "]"}], "==", "v0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "v"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<ExplicitRungeKutta\>\""}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"tgrid", "=", 
        RowBox[{"N", "@", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "tmax", ",", "dt"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\:65f6\:95f4\:5386\:7a0b\:56fe", "*)"}], 
       RowBox[{"xPlot", "=", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"xFun", "[", "t", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"StringForm", "[", 
            RowBox[{
            "\"\<\[Alpha]=``, \[Beta]=``, c=``, \[Kappa]=``, \
\[CapitalOmega]=``\>\"", ",", "\[Alpha]", ",", "\[Beta]", ",", "c", ",", 
             "\[Kappa]", ",", "\[CapitalOmega]"}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vPlot", "=", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"vFun", "[", "t", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<t\>\"", ",", "\"\<v(t)\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\:76f8\:56fe", "*)"}], 
       RowBox[{"phasePlot", "=", 
        RowBox[{"ParametricPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xFun", "[", "t", "]"}], ",", 
            RowBox[{"vFun", "[", "t", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<x\>\"", ",", "\"\<v\>\""}], "}"}]}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"Opacity", "[", "0.6", "]"}], ",", "Blue"}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", "\:53c2\:8003\:5e73\:8861\:70b9\:6807\:8bb0", "*)"}], 
       RowBox[{"eqPts", "=", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"stables", ",", "0"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"eqOverlay", "=", 
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{"Red", ",", 
           RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
           RowBox[{"Point", "[", "eqPts", "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Poincar\[EAcute]", " ", "\:622a\:9762\:91c7\:6837", 
         RowBox[{"\:ff08", "\:53bb\:6389\:8fc7\:6e21\:6bb5", "\:ff09"}]}], 
        "*)"}], 
       RowBox[{"poincT0", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"tSettle", ",", 
          RowBox[{"5", " ", "T"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nP", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"tmax", "-", "poincT0"}], ")"}], "/", "T"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"poincPts", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"xFun", "[", 
             RowBox[{"poincT0", "+", 
              RowBox[{"k", " ", "T"}]}], "]"}], ",", 
            RowBox[{"vFun", "[", 
             RowBox[{"poincT0", "+", 
              RowBox[{"k", " ", "T"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", "nP"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"poincPlot", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"poincPts", ",", 
          RowBox[{"PlotStyle", "->", "Black"}], ",", 
          RowBox[{"PlotMarkers", "->", 
           RowBox[{"{", 
            RowBox[{"Automatic", ",", "8"}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "@", "xPlot"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "@", "vPlot"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Show", "[", 
        RowBox[{"phasePlot", ",", "eqOverlay", ",", "poincPlot", ",", 
         RowBox[{
         "PlotLabel", "->", 
          "\"\<Phase Portrait + Poincar\[EAcute] Section\>\""}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", "\:9ed8\:8ba4\:8c03\:7528", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"IntegrateAndPlotForced", "[", "]"}]}], "Input",
