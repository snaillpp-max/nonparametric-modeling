Cell[CellGroupData[{

Cell["2. Modes And Single-Excitation Coupling", "Subsection",ExpressionUUID->"85a06a38-7ada-f84c-857a-7a98144d3d64"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"modeList", " ", "=", " ", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "n"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "mMax"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", "nMax"}], "}"}]}], "]"}], ",",
        " ", "1"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Nm", " ", "=", " ", 
    RowBox[{"Length", "[", "modeList", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"normCoef", "[", 
    RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"m", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", "2"}], 
        "]"}], " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", " ", "==", " ", "0"}], ",", " ", "1", ",", " ", "2"}], 
        "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"Lx", " ", "Ly"}], ")"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phiAt", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m_", ",", " ", "n_"}], "}"}], ",", " ", "x_", ",", " ", "y_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"normCoef", "[", 
     RowBox[{"m", ",", " ", "n"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"m", " ", "Pi", " ", 
      RowBox[{"x", "/", "Lx"}]}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"n", " ", "Pi", " ", 
      RowBox[{"y", "/", "Ly"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"omegas", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"modeList", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], " ", 
         RowBox[{"Pi", "/", "Lx"}]}], ")"}], "^", "2"}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"modeList", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], " ", 
         RowBox[{"Pi", "/", "Ly"}]}], ")"}], "^", "2"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Ddiag", " ", "=", " ", 
   RowBox[{"2", " ", "zetaModal", " ", "omegas"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Kdiag", " ", "=", " ", 
   RowBox[{"omegas", "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"identityNm", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "Nm", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phiObs", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"phiAt", "[", 
        RowBox[{
         RowBox[{"modeList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
         RowBox[{"observerPoint", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"observerPoint", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "Nm"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Nm = \>\"", ",", " ", "Nm"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<modeList = \>\"", ",", " ", "modeList"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<dimensionless omegas = \>\"", ",", " ", 
    RowBox[{"NumberForm", "[", 
     RowBox[{"omegas", ",", " ", 
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "4"}], "}"}]}], "]"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{
