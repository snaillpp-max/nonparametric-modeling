            ")"}], " ", "&"}], ")"}], " ", "/@", " ", "predNormList"}]}], ";",
        "\n", "   ", 
       RowBox[{"true", " ", "=", " ", 
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"rmseVec", " ", "=", " ", 
        RowBox[{"Sqrt", "@", 
         RowBox[{"Mean", "[", 
