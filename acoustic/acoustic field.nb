            "nonlinearVelocity", "+", "force"}]}], "]"}]}], ";", 
        RowBox[{"Join", "[", 
         RowBox[{"v", ",", "acc"}], "]"}]}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"rhsNN", "[", 
