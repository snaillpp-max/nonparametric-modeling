Cell[CellGroupData[{

Cell["5. Nonparametric Dynamics Data Generation", "Section",ExpressionUUID->"ebc580f4-f9dc-2d48-bfb3-cf092381d193"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "20260616", "]"}], ";", 
  RowBox[{"dataDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "nbDir", ",", "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], 
     "}"}], "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"DirectoryQ", "[", "dataDir", "]"}]}], ",", 
    RowBox[{"CreateDirectory", "[", "dataDir", "]"}]}], "]"}], ";", 
  RowBox[{"inputDim", "=", 
   RowBox[{
    RowBox[{"2", " ", "Nm"}], "+", "1"}]}], ";", 
  RowBox[{"outputDim", "=", "Nm"}], ";", 
  RowBox[{"uAmpList", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0.01`", ",", "0.11`", ",", "0.01`"}], "]"}], "]"}]}], ";", 
  RowBox[{"omegaCoarseRangeData", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "8"}], "}"}]}], ";", 
  RowBox[{"omegaCoarseStepData", "=", "0.2"}], ";", 
  RowBox[{"omegaFactorFineRangesData", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"0.98`", ",", "1.02`"}], "}"}], "}"}]}], ";", 
  RowBox[{"omegaFactorFineStepData", "=", "0.002"}], ";", 
  RowBox[{
   RowBox[{"factorGridData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fMin_", ",", "fMax_"}], "}"}], ",", "fStep_"}], "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"fMin", ",", 
        RowBox[{"fMax", "+", 
         FractionBox["fStep", "10"]}], ",", "fStep"}], "]"}], ",", 
      FractionBox["1", 
       SuperscriptBox["10", "12"]]}], "]"}], "]"}]}], ";", 
  RowBox[{"omegaCoarseListData", "=", 
   RowBox[{"factorGridData", "[", 
    RowBox[{"omegaCoarseRangeData", ",", "omegaCoarseStepData"}], "]"}]}], 
  ";", 
  RowBox[{"omegaFactorFineListData", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"factorGridData", "[", 
           RowBox[{"#1", ",", "omegaFactorFineStepData"}], "]"}], "&"}], 
         ")"}], "/@", "omegaFactorFineRangesData"}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#1", "-", "#2"}], "]"}], "<", 
       FractionBox["1", 
        SuperscriptBox["10", "10"]]}], "&"}]}], "]"}]}], ";", 
  RowBox[{"omegaFactorList", "=", "omegaFactorFineListData"}], ";", 
  RowBox[{"zetaModalData", "=", "0.02`"}], ";", 
  RowBox[{"excitationFrequencyCenters", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"N", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ValueQ", "[", "excitationFrequencyCentersAll", "]"}], ",", 
         "excitationFrequencyCentersAll", ",", "effectiveOmegaExc"}], "]"}], 
       "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#1", "-", "#2"}], "]"}], "<", 
       FractionBox["1", 
        SuperscriptBox["10", "10"]]}], "&"}]}], "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"excitationFrequencyCenters", "===", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<No adaptive linear excitation frequency centers found. Check rExc, \
mMax, nMax, and gammaVecExc.\>\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<adaptive linear excitation frequency centers for data generation = \>\
\"", ",", "excitationFrequencyCenters"}], "]"}], ";", 
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<  coarse omega range = \>\"", ",", "omegaCoarseRangeData", ",", 
    "\"\<, step = \>\"", ",", "omegaCoarseStepData", ",", 
    "\"\<, count = \>\"", ",", 
    RowBox[{"Length", "[", "omegaCoarseListData", "]"}]}], "]"}], ";", 
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<  fine omega-factor ranges = \>\"", ",", "omegaFactorFineRangesData", 
    ",", "\"\<, step = \>\"", ",", "omegaFactorFineStepData"}], "]"}], ";", 
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  fine omega-factor count = \>\"", ",", 
    RowBox[{"Length", "[", "omegaFactorFineListData", "]"}], ",", 
    "\"\<, factors = \>\"", ",", "omegaFactorFineListData"}], "]"}], ";", 
  RowBox[{"omegaList", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Join", "[", 
       RowBox[{"omegaCoarseListData", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"fac", " ", "om0"}], ",", 
           RowBox[{"{", 
            RowBox[{"om0", ",", "excitationFrequencyCenters"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"fac", ",", "omegaFactorFineListData"}], "}"}]}], "]"}], 
         "]"}]}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#1", "-", "#2"}], "]"}], "<", 
       FractionBox["1", 
        SuperscriptBox["10", "10"]]}], "&"}]}], "]"}]}], ";", 
  RowBox[{"qDecayInitAmp", "=", "0.35`"}], ";", 
  RowBox[{"uAmpZeroTolData", "=", 
   FractionBox["1", 
    SuperscriptBox["10", "12"]]}], ";", 
  RowBox[{"qZeroTolData", "=", 
   FractionBox["1.`", 
    SuperscriptBox["10", "8"]]}], ";", 
  RowBox[{"zeroPlateauCountData", "=", "20"}], ";", 
  RowBox[{"drivenModeIndexData", "=", 
   RowBox[{"First", "[", "effectiveModeIndexExc", "]"}]}], ";", 
  RowBox[{"zeroStateData", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0.`", ",", 
     RowBox[{"2", " ", "Nm"}]}], "]"}]}], ";", 
  RowBox[{"initialDisplacementModeIndexData", "=", "1"}], ";", 
  RowBox[{"initialDisplacementData", "=", "0.1`"}], ";", 
  RowBox[{"qInitialDisplacementData", "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.`", ",", "Nm"}], "]"}], ",", 
     RowBox[{
     "initialDisplacementModeIndexData", "\[Rule]", 
      "initialDisplacementData"}]}], "]"}]}], ";", 
  RowBox[{"initialDisplacementStateData", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"qInitialDisplacementData", ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.`", ",", "Nm"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"initialStateListData", "=", 
   RowBox[{"{", "zeroStateData", "}"}]}], ";", 
  RowBox[{"initialStateLabelListData", "=", 
   RowBox[{"{", "\"\<zeroState\>\"", "}"}]}], ";", 
  RowBox[{"decayInitStateData", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ReplacePart", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.`", ",", "Nm"}], "]"}], ",", 
       RowBox[{"drivenModeIndexData", "\[Rule]", "qDecayInitAmp"}]}], "]"}], 
     ",", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.`", ",", "Nm"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"initConfigCountData", "=", 
   RowBox[{"Length", "[", "initialStateListData", "]"}]}], ";", 
  RowBox[{"periodCountData", "=", "50"}], ";", 
  RowBox[{"samplesPerPeriodData", "=", "200"}], ";", 
  RowBox[{"trainRatio", "=", "0.7`"}], ";", 
  RowBox[{"valRatio", "=", "0.15`"}], ";", 
  RowBox[{"localStateAugmentationEnabled", "=", "True"}], ";", 
  RowBox[{"localStateAugmentationCopies", "=", "4"}], ";", 
  RowBox[{"localStateAugmentationApplyToValidation", "=", "True"}], ";", 
  RowBox[{"localStateAugmentationApplyToTest", "=", "False"}], ";", 
  RowBox[{"localStateAugmentationRelativeScale", "=", "0.2`"}], ";", 
  RowBox[{"localStateAugmentationDisplacementFloor", "=", 
   FractionBox["5.`", 
    SuperscriptBox["10", "4"]]}], ";", 
  RowBox[{"localStateAugmentationVelocityFloorVector", "=", 
   RowBox[{"localStateAugmentationDisplacementFloor", " ", "omegas"}]}], ";", 
  RowBox[{"localStateAugmentationFloorVector", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"ConstantArray", "[", 
      RowBox[{"localStateAugmentationDisplacementFloor", ",", "Nm"}], "]"}], 
     ",", "localStateAugmentationVelocityFloorVector"}], "]"}]}], ";", 
  RowBox[{"caseGridData", "=", 
   RowBox[{"DeleteDuplicatesBy", "[", 
    RowBox[{
     RowBox[{"Tuples", "[", 
      RowBox[{"{", 
       RowBox[{"uAmpList", ",", "omegaList", ",", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "initialStateListData", "]"}], "]"}]}], "}"}],
       "]"}], ",", 
     RowBox[{
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"N", "[", "#1", "]"}], ",", 
        FractionBox["1", 
         SuperscriptBox["10", "10"]]}], "]"}], "&"}]}], "]"}]}], ";", 
  RowBox[{"totalCasesData", "=", 
   RowBox[{"Length", "[", "caseGridData", "]"}]}], ";", 
