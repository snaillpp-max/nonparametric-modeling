    RowBox[{"Which", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"a", " ", "==", " ", "b", " ", "==", " ", "0"}], ",", " ", 
      "len", ",", "\n", "   ", 
      RowBox[{"a", " ", "==", " ", "b"}], ",", " ", 
      RowBox[{"len", "/", "2"}], ",", "\n", "   ", "True", ",", " ", "0"}], 
     "\n", "   ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
