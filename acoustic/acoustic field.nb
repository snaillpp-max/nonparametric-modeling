                   RowBox[{"Max", "[", 
                    RowBox[{
                    InterpretationBox[
                    StyleBox["\<\"1\"\>",
                    ShowStringCharacters->False],
                    1,
                    Editable->False], ",", "totalCasesData"}], "]"}]],
                  NumberForm[#, {4, 1}]& ], ",", "OutputForm"}], "]"}]}], ";", 
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<progress \>\"", ",", "currentCombinationData", ",", 
                "\"\</\>\"", ",", "totalCasesData", ",", "\"\< (\>\"", ",", 
                "percentTextData", ",", "\"\<%)\>\"", ",", "\"\<  ok=\>\"", 
                ",", "successCountProgressData", ",", "\"\<  failed=\>\"", 
                ",", "failedCountProgressData"}], "]"}], ";"}]}], "]"}], 
           ";"}]}], "]"}], ";", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<summary\>\"", "\[Rule]", "caseSummaryRow"}], ",", 
          RowBox[{"\"\<successCase\>\"", "\[Rule]", 
           RowBox[{"If", "[", 
            RowBox[{"caseFailedData", ",", "0", ",", "1"}], "]"}]}], ",", 
          RowBox[{"\"\<failedCase\>\"", "\[Rule]", 
           RowBox[{"If", "[", 
            RowBox[{"caseFailedData", ",", "1", ",", "0"}], "]"}]}], ",", 
          RowBox[{
          "\"\<successfulTrajectory\>\"", "\[Rule]", "successfulInitCount"}], 
          ",", 
          RowBox[{"\"\<failedTrajectory\>\"", "\[Rule]", "failedInitCount"}], 
          ",", 
          RowBox[{
          "\"\<truncatedTrajectory\>\"", "\[Rule]", "truncatedInitCount"}]}], 
         "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"caseIndex", ",", "totalCasesData"}], "}"}], ",", 
     RowBox[{"Method", "\[Rule]", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";", 
  RowBox[{"caseSummaryData", "=", 
   RowBox[{"caseResultListData", "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", "\"\<summary\>\""}], "\[RightDoubleBracket]"}]}], ";", 
  RowBox[{"successCountData", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"caseResultListData", "\[LeftDoubleBracket]", 
     RowBox[{"All", ",", "\"\<successCase\>\""}], "\[RightDoubleBracket]"}], 
    "]"}]}], ";", 
  RowBox[{"failedCountData", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"caseResultListData", "\[LeftDoubleBracket]", 
     RowBox[{"All", ",", "\"\<failedCase\>\""}], "\[RightDoubleBracket]"}], 
    "]"}]}], ";", 
  RowBox[{"successfulTrajectoryCountData", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"caseResultListData", "\[LeftDoubleBracket]", 
     RowBox[{"All", ",", "\"\<successfulTrajectory\>\""}], 
     "\[RightDoubleBracket]"}], "]"}]}], ";", 
  RowBox[{"failedTrajectoryCountData", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"caseResultListData", "\[LeftDoubleBracket]", 
     RowBox[{"All", ",", "\"\<failedTrajectory\>\""}], 
     "\[RightDoubleBracket]"}], "]"}]}], ";", 
  RowBox[{"truncatedTrajectoryCountData", "=", 
   RowBox[{"Total", "[", 
    RowBox[{"caseResultListData", "\[LeftDoubleBracket]", 
     RowBox[{"All", ",", "\"\<truncatedTrajectory\>\""}], 
     "\[RightDoubleBracket]"}], "]"}]}], ";", 
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dataReadDir", ",", "\"\<case_summary_dimensionless.csv\>\""}], 
      "}"}], "]"}], ",", 
    RowBox[{"Prepend", "[", 
     RowBox[{"caseSummaryData", ",", 
      RowBox[{"{", 
       RowBox[{
       "\"\<caseName\>\"", ",", "\"\<uAmp\>\"", ",", "\"\<omega\>\"", ",", 
        "\"\<initType\>\"", ",", "\"\<successfulTrajectory\>\"", ",", 
        "\"\<failedTrajectory\>\"", ",", "\"\<truncatedTrajectory\>\"", ",", 
        "\"\<baseSamples\>\"", ",", "\"\<trainBase\>\"", ",", 
        "\"\<valBase\>\"", ",", "\"\<testBase\>\"", ",", 
        "\"\<trainAugmented\>\"", ",", "\"\<valAugmented\>\"", ",", 
        "\"\<testAugmented\>\"", ",", "\"\<periodicDetected\>\"", ",", 
        "\"\<periodicStartPeriod\>\"", ",", "\"\<periodicStopPeriod\>\"", 
        ",", "\"\<periodicErrorAtStart\>\"", ",", "\"\<zeroTruncated\>\"", 
        ",", "\"\<truncationReason\>\"", ",", "\"\<status\>\""}], "}"}]}], 
     "]"}], ",", "\"\<CSV\>\""}], "]"}], ";", 
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Per-case parallel generation finished: okCases=\>\"", ",", 
    "successCountData", ",", "\"\<, failedCases=\>\"", ",", "failedCountData",
     ",", "\"\<, okTraj=\>\"", ",", "successfulTrajectoryCountData", ",", 
    "\"\<, failedTraj=\>\"", ",", "failedTrajectoryCountData", ",", 
    "\"\<, truncatedTraj=\>\"", ",", "truncatedTrajectoryCountData"}], "]"}], 
  ";", 
