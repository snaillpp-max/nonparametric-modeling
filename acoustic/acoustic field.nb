      "]"}]}], ";", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Solving full-modal Truth and NN rollout with pipe-style fixed-step \
RK4: omegaFactor = \>\"", ",", "omegaFactorCompare", ",", 
      "\"\<, periods = \>\"", ",", "periodCountCompare", ",", 
      "\"\<, samples/period = \>\"", ",", "samplesPerPeriodCompare", ",", 
      "\"\<, Nm = \>\"", ",", "Nm"}], "]"}], ";", 
    RowBox[{"rolloutTruth", "=", 
     RowBox[{"SimulateRollout", "[", 
      RowBox[{
      "rhsTrue", ",", "tauEndCompare", ",", "dtCompare", ",", "initialState", 
       ",", 
       RowBox[{"\"\<Name\>\"", "\[Rule]", "\"\<Truth\>\""}], ",", 
       RowBox[{"\"\<PrintEvery\>\"", "\[Rule]", "10000"}], ",", 
       RowBox[{"\"\<DivergenceLimit\>\"", "\[Rule]", "100.`"}]}], "]"}]}], 
    ";", 
    RowBox[{"rolloutNN", "=", 
     RowBox[{"SimulateRollout", "[", 
      RowBox[{
      "rhsNN", ",", "tauEndCompare", ",", "dtCompare", ",", "initialState", 
       ",", 
       RowBox[{"\"\<Name\>\"", "\[Rule]", "\"\<NN\>\""}], ",", 
       RowBox[{"\"\<PrintEvery\>\"", "\[Rule]", "10000"}], ",", 
       RowBox[{"\"\<DivergenceLimit\>\"", "\[Rule]", "100.`"}]}], "]"}]}], 
    ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"!", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"rolloutTruth", "[", "\"\<completed\>\"", "]"}], "]"}]}], "||", 
       RowBox[{"!", 
        RowBox[{"TrueQ", "[", 
         RowBox[{"rolloutNN", "[", "\"\<completed\>\"", "]"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<ERROR: Truth or NN RK4 rollout did not reach the requested final \
time.\>\"", "]"}], ";", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Truth last step = \>\"", ",", 
         RowBox[{
          RowBox[{"rolloutTruth", "[", "\"\<lastIndex\>\"", "]"}], "-", "1"}],
          ",", "\"\</\>\"", ",", 
         RowBox[{"rolloutTruth", "[", "\"\<nSteps\>\"", "]"}]}], "]"}], ";", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<NN last step = \>\"", ",", 
         RowBox[{
          RowBox[{"rolloutNN", "[", "\"\<lastIndex\>\"", "]"}], "-", "1"}], 
         ",", "\"\</\>\"", ",", 
         RowBox[{"rolloutNN", "[", "\"\<nSteps\>\"", "]"}]}], "]"}], ";", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
    RowBox[{"timeGridCompare", "=", 
     RowBox[{"rolloutTruth", "[", "\"\<tau\>\"", "]"}]}], ";", 
    RowBox[{"stateTruth", "=", 
     RowBox[{"rolloutTruth", "[", "\"\<state\>\"", "]"}]}], ";", 
    RowBox[{"stateNN", "=", 
     RowBox[{"rolloutNN", "[", "\"\<state\>\"", "]"}]}], ";", 
    RowBox[{"qTruth", "=", 
     RowBox[{"stateTruth", "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", 
       RowBox[{"1", ";;", "Nm"}]}], "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"qNN", "=", 
     RowBox[{"stateNN", "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", 
       RowBox[{"1", ";;", "Nm"}]}], "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"qError", "=", 
     RowBox[{"qNN", "-", "qTruth"}]}], ";", 
    RowBox[{"pTruth", "=", 
     RowBox[{"qTruth", ".", "phiObs"}]}], ";", 
    RowBox[{"pNN", "=", 
     RowBox[{"qNN", ".", "phiObs"}]}], ";", 
    RowBox[{"pError", "=", 
     RowBox[{"pNN", "-", "pTruth"}]}], ";", 
    RowBox[{"pressureRows", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "timeGridCompare", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "pNN", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
           RowBox[{
           "pTruth", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           ",", 
           RowBox[{
           "pError", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}],
           "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "timeGridCompare", "]"}]}], "}"}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<tau\>\"", ",", "\"\<NN\>\"", ",", "\"\<Truth\>\"", ",", 
         "\"\<Error\>\""}], "}"}]}], "]"}]}], ";", 
    RowBox[{"modalHeader", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", "\"\<tau\>\"", "}"}], ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<q\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_NN\>\""}], ",", 
            RowBox[{"\"\<q\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_Truth\>\""}], 
            ",", 
            RowBox[{"\"\<q\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_Error\>\""}]}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "Nm"}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";", 
    RowBox[{"modalRows", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "timeGridCompare", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}], "}"}], ",", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"qNN", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], ",", 
                RowBox[{"qTruth", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], ",", 
                RowBox[{"qError", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], "}"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "Nm"}], "}"}]}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "timeGridCompare", "]"}]}], "}"}]}], "]"}], 
       ",", "modalHeader"}], "]"}]}], ";", 
    RowBox[{"pressureSourceFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "dataDir", ",", 
        "\"\<nn_true_rollout_compare_pressure_source.csv\>\""}], "}"}], 
      "]"}]}], ";", 
    RowBox[{"modalSourceFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "dataDir", ",", "\"\<nn_true_rollout_compare_modal_source.csv\>\""}], 
       "}"}], "]"}]}], ";", 
    RowBox[{"summaryFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"dataDir", ",", "\"\<nn_true_rollout_compare_summary.mx\>\""}],
        "}"}], "]"}]}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{"pressureSourceFile", ",", "pressureRows", ",", "\"\<CSV\>\""}], 
     "]"}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{"modalSourceFile", ",", "modalRows", ",", "\"\<CSV\>\""}], "]"}],
     ";", 
    RowBox[{"compareSummary", "=", 
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<truthUsesFullModes\>\"", "\[Rule]", "True"}], ",", 
       RowBox[{
       "\"\<rolloutIntegrator\>\"", "\[Rule]", 
        "\"\<pipe-style fixed-step RK4\>\""}], ",", 
       RowBox[{"\"\<uAmp\>\"", "\[Rule]", "uAmpCompare"}], ",", 
       RowBox[{"\"\<omegaFactor\>\"", "\[Rule]", "omegaFactorCompare"}], ",", 
       RowBox[{"\"\<omega\>\"", "\[Rule]", 
        RowBox[{"N", "[", "omegaCompare", "]"}]}], ",", 
       RowBox[{"\"\<period\>\"", "\[Rule]", 
        RowBox[{"N", "[", "periodCompare", "]"}]}], ",", 
       RowBox[{"\"\<periodCount\>\"", "\[Rule]", "periodCountCompare"}], ",", 
       RowBox[{
       "\"\<samplesPerPeriod\>\"", "\[Rule]", "samplesPerPeriodCompare"}], 
       ",", 
       RowBox[{"\"\<timeStep\>\"", "\[Rule]", "dtCompare"}], ",", 
       RowBox[{"\"\<Nm\>\"", "\[Rule]", "Nm"}], ",", 
       RowBox[{"\"\<activeModeIndices\>\"", "\[Rule]", "activeModeIndices"}], 
       ",", 
       RowBox[{
       "\"\<inactiveModeIndices\>\"", "\[Rule]", "inactiveModeIndices"}], ",", 
       RowBox[{
       "\"\<nnInactiveAccelerationControl\>\"", "\[Rule]", 
        "\"\<inactive accelerations forced to zero\>\""}], ",", 
       RowBox[{"\"\<pressureRMSE\>\"", "\[Rule]", 
        SqrtBox[
         RowBox[{"Mean", "[", 
          SuperscriptBox["pError", "2"], "]"}]]}], ",", 
       RowBox[{"\"\<pressureNRMSE\>\"", "\[Rule]", 
        FractionBox[
         SqrtBox[
          RowBox[{"Mean", "[", 
           SuperscriptBox["pError", "2"], "]"}]], 
         RowBox[{"StandardDeviation", "[", "pTruth", "]"}]]}], ",", 
       RowBox[{"\"\<modalRMSE\>\"", "\[Rule]", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"\"\<q\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "Nm"}], "}"}]}], "]"}], ",", 
          SqrtBox[
           RowBox[{"Mean", "/@", 
            RowBox[{"Transpose", "[", 
             SuperscriptBox["qError", "2"], "]"}]}]]}], "]"}]}], ",", 
       RowBox[{
       "\"\<pressureSourceFile\>\"", "\[Rule]", "pressureSourceFile"}], ",", 
       RowBox[{"\"\<modalSourceFile\>\"", "\[Rule]", "modalSourceFile"}]}], 
      "]"}]}], ";", 
    RowBox[{"Export", "[", 
     RowBox[{"summaryFile", ",", "compareSummary", ",", "\"\<MX\>\""}], "]"}],
     ";", 
    RowBox[{"Print", "[", "compareSummary", "]"}], ";", "compareSummary"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.990740504569639*^9, 3.99074052439575*^9}, {
