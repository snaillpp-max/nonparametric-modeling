Cell[BoxData[
 RowBox[{
  RowBox[{"successCountData", "=", "0"}], ";", 
  RowBox[{"failedCountData", "=", "0"}], ";", 
  RowBox[{"successfulTrajectoryCountData", "=", "0"}], ";", 
  RowBox[{"failedTrajectoryCountData", "=", "0"}], ";", 
  RowBox[{"truncatedTrajectoryCountData", "=", "0"}], ";", 
  RowBox[{"caseSummaryData", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"DdiagData", "=", 
   RowBox[{"2", " ", "zetaModalData", " ", "omegas"}]}], ";", 
  RowBox[{"KdiagData", "=", 
   SuperscriptBox["omegas", "2"]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"Kernels", "[", "]"}], "]"}], "\[Equal]", "0"}], ",", 
    RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
  RowBox[{"parallelKernelCountData", "=", 
   RowBox[{"Length", "[", 
    RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
  RowBox[{"dataReadDir", "=", "dataDir"}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"DirectoryQ", "[", "dataReadDir", "]"}]}], ",", 
    RowBox[{"CreateDirectory", "[", "dataReadDir", "]"}]}], "]"}], ";", 
  RowBox[{"oldGeneratedFiles", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"FileNames", "[", 
       RowBox[{"\"\<*_train.mx\>\"", ",", "dataReadDir"}], "]"}], ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{"\"\<*_val.mx\>\"", ",", "dataReadDir"}], "]"}], ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{"\"\<*_test.mx\>\"", ",", "dataReadDir"}], "]"}], ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{"\"\<case_summary_dimensionless.csv\>\"", ",", "dataReadDir"}],
        "]"}], ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{
       "\"\<active_mode_phase_metrics_dimensionless.csv\>\"", ",", 
        "dataReadDir"}], "]"}], ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{
       "\"\<trainData_cavity_dimensionless.mx\>\"", ",", "dataReadDir"}], 
       "]"}], ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{
       "\"\<valData_cavity_dimensionless.mx\>\"", ",", "dataReadDir"}], "]"}],
       ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{
       "\"\<testData_cavity_dimensionless.mx\>\"", ",", "dataReadDir"}], 
       "]"}], ",", 
      RowBox[{"FileNames", "[", 
       RowBox[{
       "\"\<normParams_cavity_dimensionless.mx\>\"", ",", "dataReadDir"}], 
       "]"}]}], "]"}], "]"}]}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"oldGeneratedFiles", "=!=", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"DeleteFile", "/@", 
     RowBox[{"Select", "[", 
      RowBox[{"oldGeneratedFiles", ",", "FileExistsQ"}], "]"}]}]}], "]"}], 
  ";", 
  RowBox[{
  "Print", "[", "\"\<Parallel single-excitation case generation:\>\"", "]"}], 
  ";", 
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  kernels = \>\"", ",", "parallelKernelCountData"}], "]"}], 
  ";", 
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  output directory = \>\"", ",", "dataReadDir"}], "]"}], ";", 
  RowBox[{"Print", "[", 
   RowBox[{"\"\<  cleaned old generated files = \>\"", ",", 
    RowBox[{"Length", "[", "oldGeneratedFiles", "]"}]}], "]"}], ";", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "localStateAugmentationFloorVector", "]"}], "=!=", 
     RowBox[{"2", " ", "Nm"}]}], ",", 
    RowBox[{
     RowBox[{
     "Print", "[", 
      "\"\<ERROR: localStateAugmentationFloorVector length must equal 2 Nm.\>\
\"", "]"}], ";", 
     RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
  RowBox[{"currentCombinationData", "=", "0"}], ";", 
  RowBox[{"successCountProgressData", "=", "0"}], ";", 
  RowBox[{"failedCountProgressData", "=", "0"}], ";", 
  RowBox[{"counterLockData", "=", 
   RowBox[{"Unique", "[", "\"\<counterLockData$\>\"", "]"}]}], ";", 
  RowBox[{"SetSharedVariable", "[", 
   RowBox[{
   "currentCombinationData", ",", "successCountProgressData", ",", 
    "failedCountProgressData"}], "]"}], ";", 
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{
   "Nm", ",", "omegas", ",", "identityNm", ",", "kappaNL", ",", "CtForMass", 
    ",", "Ctensor", ",", "gammaVecExc", ",", "DdiagData", ",", "KdiagData", 
    ",", "caseGridData", ",", "zeroStateData", ",", 
    "initialDisplacementModeIndexData", ",", "initialDisplacementData", ",", 
    "qInitialDisplacementData", ",", "initialDisplacementStateData", ",", 
    "initialStateListData", ",", "initialStateLabelListData", ",", 
    "initConfigCountData", ",", "decayInitStateData", ",", "uAmpZeroTolData", 
    ",", "periodCountData", ",", "samplesPerPeriodData", ",", "trainRatio", 
    ",", "valRatio", ",", "qZeroTolData", ",", "zeroPlateauCountData", ",", 
    "dataReadDir", ",", "totalCasesData", ",", "counterLockData", ",", 
    "localStateAugmentationEnabled", ",", "localStateAugmentationCopies", ",",
     "localStateAugmentationApplyToValidation", ",", 
    "localStateAugmentationApplyToTest", ",", 
    "localStateAugmentationRelativeScale", ",", 
    "localStateAugmentationFloorVector"}], "]"}], ";", 
  RowBox[{"caseResultListData", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "caseU", ",", "caseOmega", ",", "caseInitIndex", ",", "periodData", 
         ",", "tauEndData", ",", "dtSampleData", ",", "tGridData", ",", 
         "samples", ",", "successfulInitCount", ",", "failedInitCount", ",", 
         "truncatedInitCount", ",", "initialStateCase", ",", "initLabelData", 
         ",", "sdotData", ",", "rhsData", ",", "accelerationFromInputData", 
         ",", "perturbStateData", ",", "localAugmentRuleData", ",", 
         "localAugmentDatasetData", ",", "solCase", ",", "domainEndData", ",",
          "tGridEvalData", ",", "stateValsData", ",", "derivValsData", ",", 
         "zeroFlagsData", ",", "zeroWindowStartsData", ",", 
         "zeroKeepCountData", ",", "keepCountData", ",", "tGridUsedData", ",",
          "stateValsUsedData", ",", "derivValsUsedData", ",", "caseData", ",",
          "caseName", ",", "shuffledData", ",", "splitIdx1", ",", "splitIdx2",
          ",", "trainCaseData", ",", "valCaseData", ",", "testCaseData", ",", 
         "trainBaseCountData", ",", "valBaseCountData", ",", 
         "testBaseCountData", ",", "caseStatusData", ",", "exportOkData", ",",
          "caseSummaryRow", ",", "caseFailedData", ",", "percentTextData", 
         ",", "tt", ",", "xx", ",", "periodicDetectedData", ",", 
         "periodicStartPeriodData", ",", "periodicStopPeriodData", ",", 
         "periodicErrorAtStartData", ",", "zeroTruncatedData", ",", 
         "truncationReasonData"}], "}"}], ",", 
       RowBox[{
        RowBox[{"caseU", "=", 
         RowBox[{"caseGridData", "\[LeftDoubleBracket]", 
          RowBox[{"caseIndex", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"caseOmega", "=", 
         RowBox[{"caseGridData", "\[LeftDoubleBracket]", 
          RowBox[{"caseIndex", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"caseInitIndex", "=", 
         RowBox[{"caseGridData", "\[LeftDoubleBracket]", 
          RowBox[{"caseIndex", ",", "3"}], "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"SeedRandom", "[", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"Hash", "[", 
            RowBox[{"{", 
             RowBox[{
             "caseIndex", ",", "caseU", ",", "caseOmega", ",", 
              "caseInitIndex"}], "}"}], "]"}], ",", 
           RowBox[{
            SuperscriptBox["2", "31"], "-", "1"}]}], "]"}], "]"}], ";", 
        RowBox[{"periodData", "=", 
         FractionBox[
          RowBox[{"2", " ", "\[Pi]"}], "caseOmega"]}], ";", 
        RowBox[{"tauEndData", "=", 
         RowBox[{"periodCountData", " ", "periodData"}]}], ";", 
        RowBox[{"dtSampleData", "=", 
         FractionBox["periodData", "samplesPerPeriodData"]}], ";", 
        RowBox[{"tGridData", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"0.`", ",", "tauEndData", ",", "dtSampleData"}], "]"}], 
          "]"}]}], ";", 
        RowBox[{"samples", "=", 
         RowBox[{"{", "}"}]}], ";", 
        RowBox[{"successfulInitCount", "=", "0"}], ";", 
        RowBox[{"failedInitCount", "=", "0"}], ";", 
        RowBox[{"truncatedInitCount", "=", "0"}], ";", 
        RowBox[{"initialStateCase", "=", 
         RowBox[{
         "initialStateListData", "\[LeftDoubleBracket]", "caseInitIndex", 
          "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{"initLabelData", "=", 
         RowBox[{
         "initialStateLabelListData", "\[LeftDoubleBracket]", "caseInitIndex",
           "\[RightDoubleBracket]"}]}], ";", 
        RowBox[{
         RowBox[{"sdotData", "[", "tt_", "]"}], ":=", 
         RowBox[{
          RowBox[{"-", "caseU"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"caseOmega", " ", "tt"}], "]"}]}]}], ";", 
        RowBox[{
         RowBox[{"rhsData", "[", 
          RowBox[{
           RowBox[{"tt_", "?", "NumericQ"}], ",", 
           RowBox[{"state_", "?", "VectorQ"}]}], "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "q", ",", "v", ",", "sdotNow", ",", "mass", ",", "dv", ",", "kq", 
             ",", "nonlinearVelocity", ",", "force", ",", "acc"}], "}"}], ",", 
           RowBox[{
            RowBox[{"q", "=", 
             RowBox[{"state", "\[LeftDoubleBracket]", 
              RowBox[{"1", ";;", "Nm"}], "\[RightDoubleBracket]"}]}], ";", 
            RowBox[{"v", "=", 
             RowBox[{"state", "\[LeftDoubleBracket]", 
              RowBox[{
               RowBox[{"Nm", "+", "1"}], ";;", 
               RowBox[{"2", " ", "Nm"}]}], "\[RightDoubleBracket]"}]}], ";", 
            RowBox[{"sdotNow", "=", 
             RowBox[{"sdotData", "[", "tt", "]"}]}], ";", 
            RowBox[{"mass", "=", 
             RowBox[{"identityNm", "-", 
              RowBox[{"2.`", " ", "kappaNL", " ", 
               RowBox[{"CtForMass", ".", "q"}]}]}]}], ";", 
            RowBox[{"dv", "=", 
             RowBox[{"DdiagData", " ", "v"}]}], ";", 
            RowBox[{"kq", "=", 
             RowBox[{"KdiagData", " ", "q"}]}], ";", 
            RowBox[{"nonlinearVelocity", "=", 
             RowBox[{"2.`", " ", "kappaNL", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"v", ".", "#1", ".", "v"}], "&"}], ")"}], "/@", 
               "Ctensor"}]}]}], ";", 
            RowBox[{"force", "=", 
             RowBox[{
              RowBox[{"-", "gammaVecExc"}], " ", "sdotNow"}]}], ";", 
            RowBox[{"acc", "=", 
             RowBox[{"LinearSolve", "[", 
              RowBox[{"mass", ",", 
               RowBox[{
                RowBox[{"-", "dv"}], "-", "kq", "+", "nonlinearVelocity", "+",
                 "force"}]}], "]"}]}], ";", 
            RowBox[{"Join", "[", 
             RowBox[{"v", ",", "acc"}], "]"}]}]}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"accelerationFromInputData", "[", 
          RowBox[{"input_", "?", "VectorQ"}], "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "state", ",", "q", ",", "v", ",", "sdotNow", ",", "mass", ",", 
             "dv", ",", "kq", ",", "nonlinearVelocity", ",", "force", ",", 
             "acc"}], "}"}], ",", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "input", "]"}], "=!=", 
               RowBox[{
                RowBox[{"2", " ", "Nm"}], "+", "1"}]}], ",", 
              RowBox[{"Return", "[", "Nothing", "]"}]}], "]"}], ";", 
            RowBox[{"state", "=", 
             RowBox[{"N", "[", 
              RowBox[{"input", "\[LeftDoubleBracket]", 
               RowBox[{"1", ";;", 
                RowBox[{"2", " ", "Nm"}]}], "\[RightDoubleBracket]"}], 
              "]"}]}], ";", 
            RowBox[{"q", "=", 
             RowBox[{"state", "\[LeftDoubleBracket]", 
              RowBox[{"1", ";;", "Nm"}], "\[RightDoubleBracket]"}]}], ";", 
            RowBox[{"v", "=", 
             RowBox[{"state", "\[LeftDoubleBracket]", 
              RowBox[{
               RowBox[{"Nm", "+", "1"}], ";;", 
               RowBox[{"2", " ", "Nm"}]}], "\[RightDoubleBracket]"}]}], ";", 
            RowBox[{"sdotNow", "=", 
             RowBox[{"N", "[", 
              RowBox[{"input", "\[LeftDoubleBracket]", 
               RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "]"}]}], ";", 
            RowBox[{"mass", "=", 
             RowBox[{"identityNm", "-", 
              RowBox[{"2.`", " ", "kappaNL", " ", 
               RowBox[{"CtForMass", ".", "q"}]}]}]}], ";", 
            RowBox[{"dv", "=", 
             RowBox[{"DdiagData", " ", "v"}]}], ";", 
            RowBox[{"kq", "=", 
             RowBox[{"KdiagData", " ", "q"}]}], ";", 
            RowBox[{"nonlinearVelocity", "=", 
             RowBox[{"2.`", " ", "kappaNL", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"v", ".", "#1", ".", "v"}], "&"}], ")"}], "/@", 
               "Ctensor"}]}]}], ";", 
            RowBox[{"force", "=", 
             RowBox[{
              RowBox[{"-", "gammaVecExc"}], " ", "sdotNow"}]}], ";", 
            RowBox[{"acc", "=", 
             RowBox[{"Quiet", "[", 
              RowBox[{
               RowBox[{"Check", "[", 
                RowBox[{
                 RowBox[{"LinearSolve", "[", 
                  RowBox[{"mass", ",", 
                   RowBox[{
                    RowBox[{"-", "dv"}], "-", "kq", "+", "nonlinearVelocity", 
                    "+", "force"}]}], "]"}], ",", "$Failed"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 StyleBox[
                  RowBox[{"LinearSolve", "::", "luc"}], "MessageName"], ",", 
                 StyleBox[
                  RowBox[{"General", "::", "stop"}], "MessageName"]}], 
                "}"}]}], "]"}]}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"acc", "===", "$Failed"}], "||", 
               RowBox[{"!", 
                RowBox[{"VectorQ", "[", 
                 RowBox[{"acc", ",", "NumericQ"}], "]"}]}], "||", 
               RowBox[{
                RowBox[{"Length", "[", "acc", "]"}], "=!=", "Nm"}], "||", 
               RowBox[{"!", 
                RowBox[{"FreeQ", "[", 
                 RowBox[{"acc", ",", 
                  RowBox[{
                  "_Complex", "|", "Indeterminate", "|", "ComplexInfinity", 
                   "|", 
                   RowBox[{"DirectedInfinity", "[", "_", "]"}]}]}], "]"}]}]}],
               ",", "Nothing", ",", 
              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{"Join", "[", 
                 RowBox[{"state", ",", 
                  RowBox[{"{", "sdotNow", "}"}]}], "]"}], "]"}], "\[Rule]", 
               RowBox[{"N", "[", "acc", "]"}]}]}], "]"}]}]}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"perturbStateData", "[", 
          RowBox[{"state_", "?", "VectorQ"}], "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "scale", "}"}], ",", 
           RowBox[{
            RowBox[{"scale", "=", 
             RowBox[{"localStateAugmentationRelativeScale", " ", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{
                   RowBox[{"Abs", "[", "#1", "]"}], ",", "#2"}], "]"}], "&"}],
                 ",", 
                RowBox[{"{", 
                 RowBox[{"state", ",", "localStateAugmentationFloorVector"}], 
                 "}"}]}], "]"}]}]}], ";", 
            RowBox[{"N", "[", 
             RowBox[{"state", "+", 
              RowBox[{
               RowBox[{"RandomReal", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "1.`"}], ",", "1.`"}], "}"}], ",", 
                 RowBox[{"2", " ", "Nm"}]}], "]"}], " ", "scale"}]}], 
             "]"}]}]}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"localAugmentRuleData", "[", "rule_Rule", "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"input", ",", "state", ",", "sdotNow"}], "}"}], ",", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"!", 
                RowBox[{
                "TrueQ", "[", "localStateAugmentationEnabled", "]"}]}], "||", 
