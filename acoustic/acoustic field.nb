        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tauNow", "=", 
            RowBox[{
            "tauList", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}], ";", 
           RowBox[{"stateNew", "=", 
            RowBox[{"Quiet", "[", 
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{"RK4Step", "[", 
                RowBox[{"rhs", ",", "tauNow", ",", "stateNow", ",", "h"}], 
                "]"}], ",", "$Failed", ",", 
