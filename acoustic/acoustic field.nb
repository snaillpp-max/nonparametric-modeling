          RowBox[{"ni", ",", " ", "nj", ",", " ", "nk", ",", " ", "Ly"}], 
          "]"}]}]}]}], "\n", "    ", "]"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "Nm"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "Nm"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "Nm"}], "}"}]}], "\n", "   ", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Ctensor", " ", "=", " ", 
   RowBox[{"N", "[", "Ctensor", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CtForMass", " ", "=", " ", 
    RowBox[{"Transpose", "[", 
     RowBox[{"Ctensor", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cosCosInt", "[", 
