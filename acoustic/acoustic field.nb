               "name", ",", 
                "\"\< stopped because a nonnumeric value appeared at tau = \>\
\"", ",", "tauNow"}], "]"}], ";", 
              RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", "stateNew", "]"}], "]"}], ">", 
