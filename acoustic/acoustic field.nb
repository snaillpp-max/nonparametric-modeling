Cell[CellGroupData[{

Cell["\<\
4. Single Point Pressure, Modal Displacements And Field Plots\
\>", "Subsection",ExpressionUUID->"807aa40b-7cdd-9c44-bd09-e6dc9286b904"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"!", 
       RowBox[{"ValueQ", "[", "nbDir", "]"}]}], " ", "||", " ", 
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "nbDir", "]"}]}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"nbDir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"StringQ", "[", "nbDir", "]"}]}], ",", " ", 
        RowBox[{"nbDir", " ", "=", " ", 
         RowBox[{"Directory", "[", "]"}]}]}], "]"}]}]}], "\n", "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotDisplay", " ", "=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"sol", " ", "===", " ", "$Failed"}], ",", "\n", "  ", 
      RowBox[{
      "Print", "[", 
       "\"\<Skip point plots because the single-excitation solution failed.\>\
\"", "]"}], ",", "\n", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"pObs", "[", 
         RowBox[{"tau_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
        RowBox[{"phiObs", " ", ".", " ", 
         RowBox[{
          RowBox[{"sol", "[", "tau", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", "Nm"}], "]"}], "]"}]}]}], ";", "\n", 
       "\n", "  ", 
       RowBox[{"nPlot", " ", "=", " ", "3000"}], ";", "\n", "  ", 
       RowBox[{"timeGridPlot", " ", "=", " ", 
        RowBox[{"N", " ", "@", " ", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"0.", ",", " ", "tauEnd", ",", " ", 
           RowBox[{"nPlot", " ", "-", " ", "1"}]}], "]"}]}]}], ";", "\n", 
       "  ", 
       RowBox[{"timeData", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"pObs", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}], " ",
          "/@", " ", "timeGridPlot"}]}], ";", "\n", "  ", 
       RowBox[{"qTimeData", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", "tau", "}"}], ",", " ", 
            RowBox[{
             RowBox[{"sol", "[", "tau", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", " ", ";;", " ", "Nm"}], "]"}], "]"}]}], "]"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"tau", ",", " ", "timeGridPlot"}], "}"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"qLabels", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<q\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "i", "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "Nm"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"qSeriesData", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"qTimeData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", 
               RowBox[{"i", " ", "+", " ", "1"}]}], "}"}]}], "]"}], "]"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "Nm"}], "}"}]}], "]"}]}], ";", "\n", "\n", 
       "  ", 
       RowBox[{"pressurePlot", " ", "=", " ", 
        RowBox[{"ListLinePlot", "[", "\n", "    ", 
         RowBox[{"timeData", ",", "\n", "    ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<tau\>\"", ",", " ", "\"\<pbar at observer\>\""}], 
            "}"}]}], ",", "\n", "    ", 
          RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
          RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", "\n", "    ", 
          RowBox[{"PlotTheme", " ", "->", " ", "\"\<Scientific\>\""}]}], "\n",
          "  ", "]"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"qDisplacementPlot", " ", "=", " ", 
        RowBox[{"ListLinePlot", "[", "\n", "    ", 
         RowBox[{"qSeriesData", ",", "\n", "    ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
            "\"\<tau\>\"", ",", " ", "\"\<generalized displacement q_i\>\""}],
             "}"}]}], ",", "\n", "    ", 
          RowBox[{"PlotLegends", " ", "->", " ", 
           RowBox[{"Placed", "[", 
            RowBox[{"qLabels", ",", " ", "Right"}], "]"}]}], ",", "\n", 
          "    ", 
          RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "    ", 
          RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", "\n", "    ", 
          RowBox[{"PlotTheme", " ", "->", " ", "\"\<Scientific\>\""}]}], "\n",
          "  ", "]"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"qComponentPlots", " ", "=", " ", 
        RowBox[{"Table", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"qSeriesData", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "\n", "      ", 
            RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "      ", 
            RowBox[{"FrameLabel", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<tau\>\"", ",", " ", 
               RowBox[{"qLabels", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], ",", "\n", 
            "      ", 
            RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "      ", 
            RowBox[{"ImageSize", " ", "->", " ", "Medium"}], ",", "\n", 
            "      ", 
            RowBox[{"PlotTheme", " ", "->", " ", "\"\<Scientific\>\""}]}], 
           "\n", "    ", "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "Nm"}], "}"}]}], "\n", "  ", "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"qDisplacementGridPlot", " ", "=", " ", 
        RowBox[{"GraphicsGrid", "[", 
         RowBox[{
          RowBox[{"Partition", "[", 
           RowBox[{"qComponentPlots", ",", " ", 
            RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], ",", " ", 
          RowBox[{"Spacings", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"0.6", ",", " ", "0.8"}], "}"}]}], ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "]"}]}], ";", 
       "\n", "\n", "  ", 
       RowBox[{"Export", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "nbDir", ",", " ", 
            "\"\<westervelt_2D_pressure_time_history_dimensionless_single.\
xlsx\>\""}], "}"}], "]"}], ",", "\n", "    ", "timeData"}], "\n", "  ", "]"}],
        ";", "\n", "  ", 
       RowBox[{"Export", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "nbDir", ",", " ", 
            "\"\<westervelt_2D_pressure_time_history_dimensionless_single.png\
\>\""}], "}"}], "]"}], ",", "\n", "    ", "pressurePlot", ",", "\n", "    ", 
         RowBox[{"ImageResolution", " ", "->", " ", "300"}]}], "\n", "  ", 
        "]"}], ";", "\n", "  ", 
       RowBox[{"Export", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "nbDir", ",", " ", 
            "\"\<westervelt_2D_generalized_displacement_time_history_\
dimensionless_single.xlsx\>\""}], "}"}], "]"}], ",", "\n", "    ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"qTimeData", ",", " ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "\"\<tau\>\"", "}"}], ",", " ", "qLabels"}], 
            "]"}]}], "]"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
       RowBox[{"Export", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "nbDir", ",", " ", 
            "\"\<westervelt_2D_generalized_displacement_time_history_\
dimensionless_single.png\>\""}], "}"}], "]"}], ",", "\n", "    ", 
         "qDisplacementPlot", ",", "\n", "    ", 
         RowBox[{"ImageResolution", " ", "->", " ", "300"}]}], "\n", "  ", 
        "]"}], ";", "\n", "  ", 
       RowBox[{"Export", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "nbDir", ",", " ", 
            "\"\<westervelt_2D_generalized_displacement_components_\
dimensionless_single.png\>\""}], "}"}], "]"}], ",", "\n", "    ", 
         "qDisplacementGridPlot", ",", "\n", "    ", 
         RowBox[{"ImageResolution", " ", "->", " ", "300"}]}], "\n", "  ", 
        "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"tauField", " ", "=", " ", "tauEnd"}], ";", "\n", "  ", 
       RowBox[{"qField", " ", "=", " ", 
        RowBox[{
         RowBox[{"sol", "[", "tauField", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "Nm"}], "]"}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"pField", "[", 
         RowBox[{
          RowBox[{"x_", "?", "NumericQ"}], ",", " ", 
          RowBox[{"y_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
        RowBox[{"qField", " ", ".", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"phiAt", "[", 
            RowBox[{
             RowBox[{"modeList", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", " ", "x", ",", " ", "y"}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "Nm"}], "}"}]}], "]"}]}]}], ";", "\n", 
       "\n", "  ", 
       RowBox[{"fieldPlot", " ", "=", " ", 
        RowBox[{"DensityPlot", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"pField", "[", 
           RowBox[{"x", ",", " ", "y"}], "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"x", ",", " ", "0", ",", " ", "Lx"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"y", ",", " ", "0", ",", " ", "Ly"}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<xbar\>\"", ",", " ", "\"\<ybar\>\""}], "}"}]}], ",", 
          "\n", "    ", 
          RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", "\n", 
          "    ", 
          RowBox[{"ColorFunction", " ", "->", " ", "\"\<SolarColors\>\""}], 
          ",", "\n", "    ", 
          RowBox[{"PlotPoints", " ", "->", " ", "60"}], ",", "\n", "    ", 
          RowBox[{"MaxRecursion", " ", "->", " ", "2"}], ",", "\n", "    ", 
          RowBox[{"ImageSize", " ", "->", " ", "Large"}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"Export", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
           "nbDir", ",", " ", 
            "\"\<westervelt_2D_pressure_field_dimensionless_single.png\>\""}],
            "}"}], "]"}], ",", "\n", "    ", "fieldPlot", ",", "\n", "    ", 
         RowBox[{"ImageResolution", " ", "->", " ", "300"}]}], "\n", "  ", 
        "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", 
         RowBox[{
         "pressurePlot", ",", " ", "qDisplacementPlot", ",", " ", 
          "qDisplacementGridPlot", ",", " ", "fieldPlot"}], "}"}], "]"}]}]}], 
     "\n", "]"}]}], ";"}], "\n"}], "\n", "plotDisplay"}], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"81bce516-d8de-dc43-8847-696b9e84cd05"],

