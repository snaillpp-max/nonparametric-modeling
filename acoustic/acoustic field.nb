          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"mk", ",", " ", "nk"}], "}"}], " ", "=", " ", 
         RowBox[{"modeList", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{
         RowBox[{"normCoef", "[", 
          RowBox[{"mi", ",", " ", "ni"}], "]"}], " ", 
         RowBox[{"normCoef", "[", 
          RowBox[{"mj", ",", " ", "nj"}], "]"}], " ", 
         RowBox[{"normCoef", "[", 
          RowBox[{"mk", ",", " ", "nk"}], "]"}], "\n", "      ", 
         RowBox[{"intCos3", "[", 
          RowBox[{"mi", ",", " ", "mj", ",", " ", "mk", ",", " ", "Lx"}], 
          "]"}], " ", 
