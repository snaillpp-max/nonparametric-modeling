     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "inputsNorm", ",", " ", "predNormList", ",", " ", "pred", ",", " ", 
