Cell[CellGroupData[{

Cell["8. Neural Surrogate Rollout Comparison", "Section",ExpressionUUID->"0a8b6623-91db-49af-85e4-bad537d510a7"],

Cell["\<\
This cell displays the exported full-modal Truth and NN rollout data in \
Mathematica.\
\>", "Text",ExpressionUUID->"e6a45fab-be9e-4cef-9f9a-899aa0a5305a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "baseDir", ",", "candidateDirs", ",", "pressureName", ",", "modalName", 
     ",", "dirHasSources", ",", "compareDir", ",", "pressureSourceFile", ",", 
     "modalSourceFile", ",", "pressureTable", ",", "modalTable", ",", 
     "pressureHeader", ",", "modalHeader", ",", "pressureDataCompare", ",", 
     "modalDataCompare", ",", "pressureCol", ",", "modalCol", ",", 
     "tauCompare", ",", "periodCompare", ",", "cyclesCompare", ",", 
     "pNNCompare", ",", "pTruthCompare", ",", "pErrorCompare", ",", 
     "qErrorCompare", ",", "qLabelsCompare", ",", "qRMSECompare", ",", 
     "pressureRMSECompare", ",", "pressureNRMSECompare", ",", "nnColor", ",", 
     "truthColor", ",", "errColor", ",", "pressurePlotCompare", ",", 
     "pressureErrorPlotCompare", ",", "modalRMSEPlotCompare", ",", 
     "compareSummary"}], "}"}], ",", 
   RowBox[{
    RowBox[{"baseDir", "=", 
     RowBox[{"Quiet", "[", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "baseDir", "]"}]}], ",", 
      RowBox[{"baseDir", "=", 
       RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";", 
    RowBox[{
    "pressureName", "=", 
     "\"\<nn_true_rollout_compare_pressure_source.csv\>\""}], ";", 
    RowBox[{
    "modalName", "=", "\"\<nn_true_rollout_compare_modal_source.csv\>\""}], 
    ";", 
    RowBox[{"candidateDirs", "=", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
            "baseDir", ",", 
             "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
           "]"}], ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directory", "[", "]"}], ",", 
             "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
           "]"}], ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directory", "[", "]"}], ",", "\"\<Code\>\"", ",", 
             "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
           "]"}], ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ParentDirectory", "[", "baseDir", "]"}], ",", 
             "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
           "]"}]}], "}"}], ",", "StringQ"}], "]"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"dirHasSources", "[", "d_", "]"}], ":=", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"d", ",", "pressureName"}], "}"}], "]"}], "]"}], "&&", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"d", ",", "modalName"}], "}"}], "]"}], "]"}]}]}], ";", 
    RowBox[{"compareDir", "=", 
     RowBox[{"FirstCase", "[", 
      RowBox[{"candidateDirs", ",", 
       RowBox[{"d_", "/;", 
        RowBox[{"dirHasSources", "[", "d", "]"}]}], ",", 
       RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"MissingQ", "[", "compareDir", "]"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<ERROR: full-modal comparison source files are missing. Run the \
integration/export section first.\>\"", "]"}], ";", 
       RowBox[{"Print", "/@", "candidateDirs"}], ";", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
    RowBox[{"pressureSourceFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"compareDir", ",", "pressureName"}], "}"}], "]"}]}], ";", 
    RowBox[{"modalSourceFile", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"compareDir", ",", "modalName"}], "}"}], "]"}]}], ";", 
    RowBox[{"pressureTable", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"pressureSourceFile", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
    RowBox[{"modalTable", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"modalSourceFile", ",", "\"\<CSV\>\""}], "]"}]}], ";", 
    RowBox[{"pressureHeader", "=", 
     RowBox[{"ToString", "/@", 
      RowBox[{"First", "[", "pressureTable", "]"}]}]}], ";", 
    RowBox[{"modalHeader", "=", 
     RowBox[{"ToString", "/@", 
      RowBox[{"First", "[", "modalTable", "]"}]}]}], ";", 
    RowBox[{"pressureDataCompare", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Rest", "[", "pressureTable", "]"}], "]"}]}], ";", 
    RowBox[{"modalDataCompare", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Rest", "[", "modalTable", "]"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"pressureCol", "[", "name_", "]"}], ":=", 
     RowBox[{
      RowBox[{"FirstPosition", "[", 
       RowBox[{"pressureHeader", ",", "name", ",", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}], 
      "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{
     RowBox[{"modalCol", "[", "name_", "]"}], ":=", 
     RowBox[{
      RowBox[{"FirstPosition", "[", 
       RowBox[{"modalHeader", ",", "name", ",", 
        RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}], 
      "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"tauCompare", "=", 
     RowBox[{"pressureDataCompare", "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", 
       RowBox[{"pressureCol", "[", "\"\<tau\>\"", "]"}]}], 
      "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"periodCompare", "=", 
     FractionBox[
      RowBox[{"Max", "[", "tauCompare", "]"}], "200.`"]}], ";", 
    RowBox[{"cyclesCompare", "=", 
     FractionBox["tauCompare", "periodCompare"]}], ";", 
    RowBox[{"pNNCompare", "=", 
     RowBox[{"pressureDataCompare", "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", 
       RowBox[{"pressureCol", "[", "\"\<NN\>\"", "]"}]}], 
      "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"pTruthCompare", "=", 
     RowBox[{"pressureDataCompare", "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", 
       RowBox[{"pressureCol", "[", "\"\<Truth\>\"", "]"}]}], 
      "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"pErrorCompare", "=", 
     RowBox[{"pressureDataCompare", "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", 
       RowBox[{"pressureCol", "[", "\"\<Error\>\"", "]"}]}], 
      "\[RightDoubleBracket]"}]}], ";", 
    RowBox[{"qLabelsCompare", "=", 
     RowBox[{"StringReplace", "[", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"modalHeader", ",", 
         RowBox[{"h_", "/;", 
          RowBox[{"StringEndsQ", "[", 
           RowBox[{"h", ",", "\"\<_NN\>\""}], "]"}]}]}], "]"}], ",", 
       RowBox[{"\"\<_NN\>\"", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";", 
    RowBox[{"qErrorCompare", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"modalDataCompare", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", 
          RowBox[{"modalCol", "[", 
           RowBox[{"q", "<>", "\"\<_Error\>\""}], "]"}]}], 
         "\[RightDoubleBracket]"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", "qLabelsCompare"}], "}"}]}], "]"}], "]"}]}], ";", 
    RowBox[{"qRMSECompare", "=", 
     SqrtBox[
      RowBox[{"Mean", "/@", 
       RowBox[{"Transpose", "[", 
        SuperscriptBox["qErrorCompare", "2"], "]"}]}]]}], ";", 
    RowBox[{"pressureRMSECompare", "=", 
     SqrtBox[
      RowBox[{"Mean", "[", 
       SuperscriptBox["pErrorCompare", "2"], "]"}]]}], ";", 
    RowBox[{"pressureNRMSECompare", "=", 
     FractionBox["pressureRMSECompare", 
      RowBox[{"StandardDeviation", "[", "pTruthCompare", "]"}]]}], ";", 
    RowBox[{"nnColor", "=", 
     RowBox[{"RGBColor", "[", 
      RowBox[{"0.996078431372549`", ",", "0.3803921568627451`", ",", "0.`"}], 
      "]"}]}], ";", 
    RowBox[{"truthColor", "=", 
     RowBox[{"RGBColor", "[", 
      RowBox[{
      "0.027450980392156862`", ",", "0.49411764705882355`", ",", 
       "0.596078431372549`"}], "]"}]}], ";", 
    RowBox[{"errColor", "=", 
     RowBox[{"RGBColor", "[", 
      RowBox[{
      "0.2980392156862745`", ",", "0.2980392156862745`", ",", 
       "0.29411764705882354`"}], "]"}]}], ";", 
    RowBox[{"compareSummary", "=", 
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<sourceDirectory\>\"", "\[Rule]", "compareDir"}], ",", 
       RowBox[{"\"\<cycles\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Min", "[", "cyclesCompare", "]"}], ",", 
          RowBox[{"Max", "[", "cyclesCompare", "]"}]}], "}"}]}], ",", 
       RowBox[{"\"\<truthUsesFullModes\>\"", "\[Rule]", "True"}], ",", 
       RowBox[{"\"\<pressureRMSE\>\"", "\[Rule]", "pressureRMSECompare"}], 
       ",", 
       RowBox[{"\"\<pressureNRMSE\>\"", "\[Rule]", "pressureNRMSECompare"}], 
       ",", 
       RowBox[{"\"\<modalRMSE\>\"", "\[Rule]", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"qLabelsCompare", "\[Rule]", "qRMSECompare"}], "]"}]}]}], 
      "]"}]}], ";", 
    RowBox[{"Print", "[", "compareSummary", "]"}], ";", 
    RowBox[{"pressurePlotCompare", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"cyclesCompare", ",", "pNNCompare"}], "}"}], "]"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"cyclesCompare", ",", "pTruthCompare"}], "}"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"nnColor", ",", "Dashed", ",", 
            RowBox[{"AbsoluteThickness", "[", "1.6`", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"truthColor", ",", 
            RowBox[{"AbsoluteThickness", "[", "1.4`", "]"}]}], "}"}]}], 
         "}"}]}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"nnColor", ",", "truthColor"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<NN\>\"", ",", "\"\<Truth\>\""}], "}"}]}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"0.86`", ",", "0.86`"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Cycle\>\"", ",", "\"\<Pressure\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ";", 
    RowBox[{"pressureErrorPlotCompare", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"cyclesCompare", ",", "pErrorCompare"}], "}"}], "]"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"errColor", ",", 
          RowBox[{"AbsoluteThickness", "[", "1.2`", "]"}]}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Cycle\>\"", ",", "\"\<NN - Truth\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ";", 
    RowBox[{"modalRMSEPlotCompare", "=", 
     RowBox[{"BarChart", "[", 
      RowBox[{"qRMSECompare", ",", 
       RowBox[{"ChartLabels", "\[Rule]", 
        RowBox[{"Placed", "[", 
         RowBox[{"qLabelsCompare", ",", "Below"}], "]"}]}], ",", 
       RowBox[{"ChartStyle", "\[Rule]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"3", ",", "6"}], "}"}], ",", "i"}], "]"}], ",", 
            "nnColor", ",", 
            TemplateBox[<|"color" -> GrayLevel[0.65]|>,
             "GrayLevelColorSwatchTemplate"]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "qLabelsCompare", "]"}]}], "}"}]}], 
         "]"}]}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<Generalized displacement\>\"", ",", "\"\<RMSE\>\""}], 
         "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}]}], ";", 
    TagBox[GridBox[{
       {
        StyleBox[
         "\"\<Full-modal Truth comparison from exported 200-cycle \
response\>\"",
         StripOnInput->False,
         FontSize->13,
         FontWeight->Bold]},
       {"pressurePlotCompare"},
       {"pressureErrorPlotCompare"},
       {"modalRMSEPlotCompare"}
      },
      DefaultBaseStyle->"Column",
      GridBoxAlignment->{"Columns" -> {{Left}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
      GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{1.2}}}],
     "Column"]}]}], "]"}]], "Input",
 CellLabel->
  "In[229]:=",ExpressionUUID->"62b5a45f-aa25-4677-93d2-d17fb90d76b2"],

