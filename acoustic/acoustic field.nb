            RowBox[{"stateList", "\[LeftDoubleBracket]", 
             RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "=", 
            "stateNow"}], ";", 
           RowBox[{"lastIndex", "=", 
            RowBox[{"i", "+", "1"}]}], ";", 
           RowBox[{"If", "[", 
