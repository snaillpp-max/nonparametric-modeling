Cell[CellGroupData[{

Cell["7. Full-Modal Truth Integration and NN Rollout Export", "Section",ExpressionUUID->"846c4a86-9157-4d03-8806-c6932a8c5f97"],

Cell["\<\
This cell recomputes the 0.98-frequency, 200-cycle response using the same \
fixed-step Runge-Kutta construction style as pipe_simple. Truth is integrated \
with the full modal reduced-order equations; NN is integrated with the \
trained surrogate acceleration model. No adaptive Mathematica ODE solver is \
used in this rollout/export cell.\
\>", "Text",ExpressionUUID->"7c2cd45d-cedf-4dce-bf94-3c4f8beefa18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "baseDir", ",", "dataDir", ",", "beta", ",", "kappaNL", ",", "Lx", ",", 
     "Ly", ",", "mMax", ",", "nMax", ",", "zetaModal", ",", "rExc", ",", 
     "observerPoint", ",", "modeList", ",", "Nm", ",", "normCoef", ",", 
     "phiAt", ",", "omegas", ",", "identityNm", ",", "phiObs", ",", "intCos3",
      ",", "Ctensor", ",", "CtForMass", ",", "cosCosInt", ",", "gammaVecExc", 
     ",", "effectiveModeIndexExc", ",", "effectiveOmegaExc", ",", 
     "excitationFrequencyCenters", ",", "netFile", ",", "normFile", ",", 
     "trainedNet", ",", "normParams", ",", "inputMean", ",", "inputStd", ",", 
     "targetMean", ",", "targetStd", ",", "activeModeIndices", ",", 
     "inactiveModeIndices", ",", "nActive", ",", "uAmpCompare", ",", 
     "omegaFactorCompare", ",", "omegaCompare", ",", "periodCompare", ",", 
     "periodCountCompare", ",", "samplesPerPeriodCompare", ",", 
     "tauEndCompare", ",", "dtCompare", ",", "initialState", ",", "Ddiag", 
     ",", "Kdiag", ",", "sdot", ",", "rhsTrue", ",", "rhsNN", ",", "RK4Step", 
     ",", "SimulateRollout", ",", "rolloutTruth", ",", "rolloutNN", ",", 
     "timeGridCompare", ",", "stateTruth", ",", "stateNN", ",", "qTruth", ",",
      "qNN", ",", "qError", ",", "pTruth", ",", "pNN", ",", "pError", ",", 
     "pressureRows", ",", "modalHeader", ",", "modalRows", ",", 
     "pressureSourceFile", ",", "modalSourceFile", ",", "summaryFile", ",", 
     "compareSummary"}], "}"}], ",", 
   RowBox[{
    RowBox[{"baseDir", "=", 
     RowBox[{"Quiet", "[", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "baseDir", "]"}]}], ",", 
      RowBox[{"baseDir", "=", 
       RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";", 
    RowBox[{"dataDir", "=", 
     RowBox[{"FirstCase", "[", 
      RowBox[{
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
              "baseDir", ",", 
               "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
             "]"}], ",", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
              "baseDir", ",", "\"\<Code\>\"", ",", 
               "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
             "]"}], ",", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Directory", "[", "]"}], ",", 
               "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
             "]"}], ",", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Directory", "[", "]"}], ",", "\"\<Code\>\"", ",", 
               "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
             "]"}], ",", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ParentDirectory", "[", "baseDir", "]"}], ",", 
               "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
             "]"}]}], "}"}], ",", "StringQ"}], "]"}], "]"}], ",", 
       RowBox[{"d_", "/;", 
        RowBox[{
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
            "d", ",", "\"\<trainedNet_cavity_dimensionless_final.wlnet\>\""}],
             "}"}], "]"}], "]"}], "&&", 
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
            "d", ",", "\"\<normParams_cavity_dimensionless_final.mx\>\""}], 
            "}"}], "]"}], "]"}]}]}], ",", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "baseDir", ",", 
          "\"\<cavity_dimensionless_single_nonparam_cases\>\""}], "}"}], 
        "]"}]}], "]"}]}], ";", 
    RowBox[{"beta", "=", "1.2`"}], ";", 
    RowBox[{"kappaNL", "=", "beta"}], ";", 
    RowBox[{"Lx", "=", "1.`"}], ";", 
    RowBox[{"Ly", "=", "0.8`"}], ";", 
    RowBox[{"mMax", "=", "2"}], ";", 
    RowBox[{"nMax", "=", "2"}], ";", 
    RowBox[{"zetaModal", "=", "0.02`"}], ";", 
    RowBox[{"rExc", "=", "1"}], ";", 
    RowBox[{"observerPoint", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.63`", " ", "Lx"}], ",", 
       RowBox[{"0.41`", " ", "Ly"}]}], "}"}]}], ";", 
    RowBox[{"modeList", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "n"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "0", ",", "mMax"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", "nMax"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], ";", 
    RowBox[{"Nm", "=", 
     RowBox[{"Length", "[", "modeList", "]"}]}], ";", 
    RowBox[{
     RowBox[{"normCoef", "[", 
      RowBox[{"m_", ",", "n_"}], "]"}], ":=", 
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", "\[Equal]", "0"}], ",", "1", ",", "2"}], "]"}], " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "\[Equal]", "0"}], ",", "1", ",", "2"}], "]"}]}], 
       RowBox[{"Lx", " ", "Ly"}]]]}], ";", 
    RowBox[{
     RowBox[{"phiAt", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m_", ",", "n_"}], "}"}], ",", "x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"normCoef", "[", 
       RowBox[{"m", ",", "n"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{"m", " ", "\[Pi]", " ", "x"}], "Lx"], "]"}], " ", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{"n", " ", "\[Pi]", " ", "y"}], "Ly"], "]"}]}]}], ";", 
    RowBox[{"omegas", "=", 
     RowBox[{"N", "[", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"modeList", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], " ", 
            "\[Pi]"}], "Lx"], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"modeList", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], " ", 
            "\[Pi]"}], "Ly"], ")"}], "2"]}]], "]"}]}], ";", 
    RowBox[{"identityNm", "=", 
     RowBox[{"IdentityMatrix", "[", "Nm", "]"}]}], ";", 
    RowBox[{"phiObs", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"phiAt", "[", 
         RowBox[{
          RowBox[{
          "modeList", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
          ",", 
          RowBox[{
          "observerPoint", "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}], ",", 
          RowBox[{
          "observerPoint", "\[LeftDoubleBracket]", "2", 
           "\[RightDoubleBracket]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "Nm"}], "}"}]}], "]"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"intCos3", "[", 
      RowBox[{"a_", ",", "b_", ",", "c_", ",", "len_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["1", "4"], " ", "len", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"a", "+", "b", "-", "c"}], "\[Equal]", "0"}], "]"}], "+", 
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"a", "-", "b", "+", "c"}], "\[Equal]", "0"}], "]"}], "+", 
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], "+", "b", "+", "c"}], "\[Equal]", "0"}], "]"}],
         "+", 
        RowBox[{"Boole", "[", 
         RowBox[{
          RowBox[{"a", "+", "b", "+", "c"}], "\[Equal]", "0"}], "]"}]}], 
       ")"}]}]}], ";", 
    RowBox[{"Ctensor", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "mi", ",", "ni", ",", "mj", ",", "nj", ",", "mk", ",", "nk"}], 
           "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"mi", ",", "ni"}], "}"}], "=", 
            RowBox[{
            "modeList", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}], ";", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"mj", ",", "nj"}], "}"}], "=", 
            RowBox[{
            "modeList", "\[LeftDoubleBracket]", "j", 
             "\[RightDoubleBracket]"}]}], ";", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"mk", ",", "nk"}], "}"}], "=", 
            RowBox[{
            "modeList", "\[LeftDoubleBracket]", "k", 
             "\[RightDoubleBracket]"}]}], ";", 
           RowBox[{
            RowBox[{"normCoef", "[", 
             RowBox[{"mi", ",", "ni"}], "]"}], " ", 
            RowBox[{"normCoef", "[", 
             RowBox[{"mj", ",", "nj"}], "]"}], " ", 
            RowBox[{"normCoef", "[", 
