Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"readDirData", " ", "=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ValueQ", "[", "dataReadDir", "]"}], " ", "&&", " ", 
       RowBox[{"StringQ", "[", "dataReadDir", "]"}], " ", "&&", " ", 
       RowBox[{"DirectoryQ", "[", "dataReadDir", "]"}]}], ",", " ", 
      "dataReadDir", ",", " ", "dataDir"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<Reading generated case files from \>\"", ",", " ", "readDirData"}], 
    "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"kTrainPerCase", " ", "=", " ", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kValPerCase", " ", "=", "200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kTestPerCase", " ", "=", " ", "200"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"useActiveModeTraining", " ", "=", " ", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "activeModeSelectionMethod", " ", "=", " ", 
   "\"\<automatic phase-space response metric\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phaseMetricSamplesPerFile", " ", "=", " ", "1200"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phaseMetricMaxFiles", " ", "=", " ", "120"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phaseMetricRelativeThreshold", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "3"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"phaseMetricAbsoluteThreshold", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "6"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"activeModeDetectionUseTrainOnly", " ", "=", " ", "True"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"trainFiles", " ", "=", " ", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<*_train.mx\>\"", ",", " ", "readDirData"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"valFiles", " ", "=", " ", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<*_val.mx\>\"", ",", " ", "readDirData"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"testFiles", " ", "=", " ", 
    RowBox[{"FileNames", "[", 
     RowBox[{"\"\<*_test.mx\>\"", ",", " ", "readDirData"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Found case files: train=\>\"", ",", " ", 
    RowBox[{"Length", "[", "trainFiles", "]"}], ",", " ", "\"\<  val=\>\"", 
    ",", " ", 
    RowBox[{"Length", "[", "valFiles", "]"}], ",", " ", "\"\<  test=\>\"", 
    ",", " ", 
    RowBox[{"Length", "[", "testFiles", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"trainFiles", " ", "===", " ", 
       RowBox[{"{", "}"}]}], " ", "||", " ", 
      RowBox[{"valFiles", " ", "===", " ", 
       RowBox[{"{", "}"}]}], " ", "||", " ", 
      RowBox[{"testFiles", " ", "===", " ", 
       RowBox[{"{", "}"}]}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<No train/val/test files found in \>\"", ",", " ", "readDirData"}],
        "]"}], ";", "\n", "  ", 
      RowBox[{"Abort", "[", "]"}], ";"}]}], "\n", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "CollectPhasePointPairs", ",", " ", 
    "EstimateActiveModesFromPhasePointFiles"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CollectPhasePointPairs", "[", 
     RowBox[{"files_", ",", " ", "maxFiles_", ",", " ", "samplesPerFile_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sampleFiles", ",", " ", "importedData", ",", " ", "sampledData", ",", 
        " ", "lhs", ",", " ", "gathered"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"sampleFiles", " ", "=", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"RandomSample", "[", "files", "]"}], ",", " ", 
          RowBox[{"UpTo", "[", "maxFiles", "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"gathered", " ", "=", " ", 
        RowBox[{
         RowBox[{"Reap", "[", "\n", "    ", 
          RowBox[{"Do", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"importedData", " ", "=", " ", 
              RowBox[{"Quiet", "[", 
               RowBox[{"Check", "[", 
                RowBox[{
                 RowBox[{"Import", "[", 
                  RowBox[{"file", ",", " ", "\"\<MX\>\""}], "]"}], ",", " ", 
                 RowBox[{"{", "}"}]}], "]"}], "]"}]}], ";", "\n", "      ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"importedData", " ", "=!=", " ", "$Failed"}], " ", "&&",
                 " ", 
                RowBox[{"importedData", " ", "=!=", " ", 
                 RowBox[{"{", "}"}]}]}], ",", "\n", "        ", 
               RowBox[{
                RowBox[{"SeedRandom", "[", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"Hash", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<phaseMetric\>\"", ",", " ", "file"}], "}"}], 
                    "]"}], ",", " ", 
                   RowBox[{
                    RowBox[{"2", "^", "31"}], " ", "-", " ", "1"}]}], "]"}], 
                 "]"}], ";", "\n", "        ", 
                RowBox[{"sampledData", " ", "=", " ", 
                 RowBox[{"RandomSample", "[", 
                  RowBox[{"importedData", ",", " ", 
                   RowBox[{"Min", "[", 
                    RowBox[{"samplesPerFile", ",", " ", 
                    RowBox[{"Length", "[", "importedData", "]"}]}], "]"}]}], 
                  "]"}]}], ";", "\n", "        ", 
                RowBox[{"Scan", "[", "\n", "          ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"lhs", " ", "=", " ", 
                    RowBox[{"N", " ", "@", " ", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\n", 
                    "           ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"VectorQ", "[", 
                    RowBox[{"lhs", ",", " ", "NumericQ"}], "]"}], " ", "&&", 
                    " ", 
                    RowBox[{
                    RowBox[{"Length", "[", "lhs", "]"}], " ", "==", " ", 
                    RowBox[{
                    RowBox[{"2", " ", "Nm"}], " ", "+", " ", "1"}]}]}], ",", 
                    "\n", "             ", 
                    RowBox[{"Sow", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"lhs", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", " ", ";;", " ", "Nm"}], "]"}], "]"}], ",", 
                    " ", 
                    RowBox[{"lhs", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Nm", " ", "+", " ", "1"}], " ", ";;", " ", 
                    RowBox[{"2", " ", "Nm"}]}], "]"}], "]"}]}], "}"}], 
                    "]"}]}], "\n", "           ", "]"}]}], ")"}], " ", "&"}], 
                  ",", "\n", "          ", "sampledData"}], "\n", "        ", 
                 "]"}], ";"}]}], "\n", "      ", "]"}]}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"file", ",", " ", "sampleFiles"}], "}"}]}], "\n", "    ",
            "]"}], "\n", "  ", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"gathered", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"{", "}"}], ",", " ", 
         RowBox[{"gathered", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EstimateActiveModesFromPhasePointFiles", "[", "files_", "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "phasePointPairs", ",", " ", "qMat", ",", " ", "vMat", ",", " ", 
        "vScaledMat", ",", " ", "qStdVec", ",", " ", "vScaledStdVec", ",", 
        " ", "phaseMetricVec", ",", " ", "maxPhaseMetric", ",", " ", 
        "phaseMetricRelVec", ",", " ", "active", ",", " ", "metricRows"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"phasePointPairs", " ", "=", " ", 
        RowBox[{"CollectPhasePointPairs", "[", 
         RowBox[{
         "files", ",", " ", "phaseMetricMaxFiles", ",", " ", 
          "phaseMetricSamplesPerFile"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"phasePointPairs", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", "\n", "    ", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", "\n", "      ", 
           RowBox[{
            RowBox[{"\"\<phasePointCount\>\"", " ", "->", " ", "0"}], ",", 
            "\n", "      ", 
            RowBox[{"\"\<qStd\>\"", " ", "->", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.", ",", " ", "Nm"}], "]"}]}], ",", "\n", "      ", 
            RowBox[{"\"\<qdotOverOmegaStd\>\"", " ", "->", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.", ",", " ", "Nm"}], "]"}]}], ",", "\n", "      ", 
            RowBox[{"\"\<phaseMetric\>\"", " ", "->", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.", ",", " ", "Nm"}], "]"}]}], ",", "\n", "      ", 
            RowBox[{"\"\<relativePhaseMetric\>\"", " ", "->", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.", ",", " ", "Nm"}], "]"}]}], ",", "\n", "      ", 
            RowBox[{"\"\<activeModeIndices\>\"", " ", "->", " ", 
             RowBox[{"Range", "[", "Nm", "]"}]}], ",", "\n", "      ", 
            RowBox[{"\"\<metricRows\>\"", " ", "->", " ", 
             RowBox[{"{", "}"}]}], ",", "\n", "      ", 
            RowBox[{
            "\"\<fallback\>\"", " ", "->", " ", 
             "\"\<empty phase-point sample; use all modes\>\""}]}], "\n", 
           "    ", "|>"}], "]"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
       RowBox[{"qMat", " ", "=", " ", 
        RowBox[{"phasePointPairs", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"vMat", " ", "=", " ", 
        RowBox[{"phasePointPairs", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"vScaledMat", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "/", "omegas"}], ")"}], " ", "&"}], " ", "/@", " ", 
         "vMat"}]}], ";", "\n", "  ", 
       RowBox[{"qStdVec", " ", "=", " ", 
        RowBox[{"StandardDeviation", " ", "/@", " ", 
         RowBox[{"Transpose", "[", "qMat", "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"vScaledStdVec", " ", "=", " ", 
        RowBox[{"StandardDeviation", " ", "/@", " ", 
         RowBox[{"Transpose", "[", "vScaledMat", "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"phaseMetricVec", " ", "=", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"qStdVec", "^", "2"}], " ", "+", " ", 
          RowBox[{"vScaledStdVec", "^", "2"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"maxPhaseMetric", " ", "=", " ", 
        RowBox[{"Max", "[", "phaseMetricVec", "]"}]}], ";", "\n", "  ", 
       RowBox[{"phaseMetricRelVec", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"maxPhaseMetric", " ", ">", " ", "0"}], ",", " ", 
          RowBox[{"phaseMetricVec", "/", "maxPhaseMetric"}], ",", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", " ", "Nm"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"active", " ", "=", " ", 
        RowBox[{"Flatten", " ", "@", " ", 
         RowBox[{"Position", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#1", " ", ">=", " ", "phaseMetricAbsoluteThreshold"}],
                " ", "&&", " ", 
               RowBox[{
               "#2", " ", ">=", " ", "phaseMetricRelativeThreshold"}]}], " ", 
              "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"phaseMetricVec", ",", " ", "phaseMetricRelVec"}], 
              "}"}]}], "]"}], ",", "\n", "    ", "True"}], "\n", "  ", 
          "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"active", " ", "===", " ", 
           RowBox[{"{", "}"}]}], " ", "&&", " ", 
          RowBox[{"maxPhaseMetric", " ", ">", " ", "0"}]}], ",", " ", 
         RowBox[{"active", " ", "=", " ", 
          RowBox[{"Flatten", " ", "@", " ", 
           RowBox[{"Position", "[", 
            RowBox[{"phaseMetricVec", ",", " ", "maxPhaseMetric"}], 
            "]"}]}]}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"active", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"active", " ", "=", " ", 
          RowBox[{"Range", "[", "Nm", "]"}]}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"active", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", "[", "active", "]"}]}], ";", "\n", "  ", 
       RowBox[{"metricRows", " ", "=", " ", 
        RowBox[{"Table", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"ToString", "[", 
