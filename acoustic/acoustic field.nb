        RowBox[{"Join", "[", 
         RowBox[{"v", ",", "acc"}], "]"}]}]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"RK4Step", "[", 
      RowBox[{"rhs_", ",", 
       RowBox[{"tau_", "?", "NumericQ"}], ",", 
