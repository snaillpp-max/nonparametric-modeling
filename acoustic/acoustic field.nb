             RowBox[{"2", " ", "k2"}], "+", 
             RowBox[{"2", " ", "k3"}], "+", "k4"}], ")"}]}]}], "]"}]}]}], 
      "]"}]}], ";", 
    RowBox[{
     RowBox[{"Options", "[", "SimulateRollout", "]"}], "=", 
     RowBox[{"{", 
