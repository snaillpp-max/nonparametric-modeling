    " ", ":=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"len", "/", "4"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Boole", "[", 
        RowBox[{
         RowBox[{"a", " ", "+", " ", "b", " ", "-", " ", "c"}], " ", "==", 
         " ", "0"}], "]"}], " ", "+", " ", 
       RowBox[{"Boole", "[", 
        RowBox[{
         RowBox[{"a", " ", "-", " ", "b", " ", "+", " ", "c"}], " ", "==", 
         " ", "0"}], "]"}], " ", "+", " ", 
       RowBox[{"Boole", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], " ", "+", " ", "b", " ", "+", " ", "c"}], " ", "==",
          " ", "0"}], "]"}], " ", "+", " ", 
       RowBox[{"Boole", "[", 
        RowBox[{
         RowBox[{"a", " ", "+", " ", "b", " ", "+", " ", "c"}], " ", "==", 
         " ", "0"}], "]"}]}], ")"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Ctensor", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
