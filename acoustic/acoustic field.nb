Cell[CellGroupData[{

Cell["3. Single Boundary Velocity Point Calculation", "Subsection",ExpressionUUID->"cde9a745-cdad-b34e-a1db-8ee63a860968"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sdotFun", "[", "tau_", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"-", "uAmp"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"omegaExc", " ", "tau"}], "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rhsFun", "[", 
     RowBox[{
      RowBox[{"tau_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"state_", "?", "VectorQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "q", ",", " ", "v", ",", " ", "sdotNow", ",", " ", "mass", ",", " ", 
        "dv", ",", " ", "kq", ",", " ", "nonlinearVelocity", ",", " ", 
        "force", ",", " ", "acc"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"state", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "Nm"}], "]"}], "]"}]}], ";", "\n", 
       "   ", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"state", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Nm", " ", "+", " ", "1"}], " ", ";;", " ", 
           RowBox[{"2", " ", "Nm"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
       RowBox[{"sdotNow", " ", "=", " ", 
        RowBox[{"sdotFun", "[", "tau", "]"}]}], ";", "\n", "   ", 
       RowBox[{"mass", " ", "=", " ", 
        RowBox[{"identityNm", " ", "-", " ", 
         RowBox[{"2.", " ", "kappaNL", " ", 
          RowBox[{"(", 
           RowBox[{"CtForMass", " ", ".", " ", "q"}], ")"}]}]}]}], ";", "\n", 
       "   ", 
       RowBox[{"dv", " ", "=", " ", 
        RowBox[{"Ddiag", " ", "v"}]}], ";", "\n", "   ", 
       RowBox[{"kq", " ", "=", " ", 
        RowBox[{"Kdiag", " ", "q"}]}], ";", "\n", "   ", 
       RowBox[{"nonlinearVelocity", " ", "=", " ", 
        RowBox[{"2.", " ", "kappaNL", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"v", " ", ".", " ", "#", " ", ".", " ", "v"}], ")"}], 
             " ", "&"}], ")"}], " ", "/@", " ", "Ctensor"}], ")"}]}]}], ";", 
       "\n", "   ", 
       RowBox[{"force", " ", "=", " ", 
        RowBox[{
         RowBox[{"-", "gammaVecExc"}], " ", "sdotNow"}]}], ";", "\n", "   ", 
       RowBox[{"acc", " ", "=", " ", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{"mass", ",", " ", 
          RowBox[{
           RowBox[{"-", "dv"}], " ", "-", " ", "kq", " ", "+", " ", 
           "nonlinearVelocity", " ", "+", " ", "force"}]}], "]"}]}], ";", 
       "\n", "   ", 
       RowBox[{"Join", "[", 
        RowBox[{"v", ",", " ", "acc"}], "]"}]}]}], "\n", "   ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"maxOmega", " ", "=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "omegaExc", "}"}], ",", " ", "omegas"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"maxStep", " ", "=", " ", 
   RowBox[{"2", " ", 
    RowBox[{"Pi", "/", 
     RowBox[{"(", 
      RowBox[{"stepsPerPeriod", " ", "maxOmega"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"initialState", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "Nm"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"initialState", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "=", "0.1"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Start single-excitation NDSolveValue...\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", " ", "=", " ", 
    RowBox[{"Quiet", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Check", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"NDSolveValue", "[", "\n", "     ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "tau", "]"}], " ", "==", " ", 
             RowBox[{"rhsFun", "[", 
              RowBox[{"tau", ",", " ", 
               RowBox[{"x", "[", "tau", "]"}]}], "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], " ", "==", " ", "initialState"}]}],
            "}"}], ",", "\n", "     ", "x", ",", "\n", "     ", 
          RowBox[{"{", 
           RowBox[{"tau", ",", " ", "0", ",", " ", "tauEnd"}], "}"}], ",", 
          "\n", "     ", 
          RowBox[{"Method", " ", "->", " ", 
           RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", "\n", 
          "     ", 
          RowBox[{"MaxStepFraction", " ", "->", " ", 
           RowBox[{"1", "/", "200"}]}], ",", "\n", "     ", 
          RowBox[{"MaxStepSize", " ", "->", " ", "maxStep"}], ",", "\n", 
          "     ", 
          RowBox[{"AccuracyGoal", " ", "->", " ", "8"}], ",", "\n", "     ", 
          RowBox[{"PrecisionGoal", " ", "->", " ", "8"}]}], "\n", "     ", 
         "]"}], ",", "\n", "    ", "$Failed"}], "\n", "    ", "]"}], ",", 
      "\n", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NDSolveValue", "::", "ndsz"}], ",", " ", 
        RowBox[{"NDSolveValue", "::", "ndnum"}], ",", " ", 
        RowBox[{"LinearSolve", "::", "luc"}], ",", " ", 
        RowBox[{"General", "::", "stop"}]}], "}"}]}], "\n", "   ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"sol", " ", "===", " ", "$Failed"}], ",", "\n", "  ", 
    RowBox[{
    "Print", "[", "\"\<Single-excitation point calculation failed.\>\"", 
     "]"}], ",", "\n", "  ", 
    RowBox[{
