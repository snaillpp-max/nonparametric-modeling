           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "nSteps"}], "]"}], " ", "h"}], "]"}]}], ";", 
        RowBox[{"stateList", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.`", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nSteps", "+", "1"}], ",", 
             RowBox[{"Length", "[", "state0", "]"}]}], "}"}]}], "]"}]}], ";", 
        RowBox[{"stateNow", "=", 
         RowBox[{"N", "[", "state0", "]"}]}], ";", 
        RowBox[{
         RowBox[{
         "stateList", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "=", "stateNow"}], ";", 
